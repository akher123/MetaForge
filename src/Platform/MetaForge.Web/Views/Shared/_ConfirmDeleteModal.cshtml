<div class="modal fade admin-modal confirm-delete-modal" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered confirm-delete-dialog">
        <div class="modal-content confirm-delete-content">
            <button type="button" class="btn-close confirm-delete-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-body confirm-delete-body">
                <div class="confirm-delete-icon-wrap" aria-hidden="true">
                    <span class="confirm-delete-icon-ring"></span>
                    <span class="confirm-delete-icon">
                        <i class="fa-solid fa-trash-can"></i>
                    </span>
                </div>
                <h5 class="confirm-delete-title" id="confirmDeleteModalTitle">Confirm Delete</h5>
                <p class="confirm-delete-message" id="confirmDeleteModalMessage">Are you sure you want to delete this item?</p>
                <p class="confirm-delete-detail" id="confirmDeleteModalDetail">This action cannot be undone.</p>
            </div>
            <div class="modal-footer confirm-delete-footer">
                <button type="button" class="btn btn-light confirm-delete-cancel" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger confirm-delete-confirm" id="confirmDeleteModalConfirm">
                    <i class="fa-solid fa-trash-can me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>
