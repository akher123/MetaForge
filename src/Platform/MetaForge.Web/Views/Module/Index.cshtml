@{
    ViewData["Title"] = ViewBag.Form?.FormName ?? "Admin";
    var form = ViewBag.Form as MetaForge.Application.DTOs.FormDefinition;
    var grid = ViewBag.Grid as MetaForge.Application.DTOs.GridDefinition;
    var formCode = ViewBag.FormCode as string;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.FormPermissionsDto;
    var hasMasterDetail = ViewBag.HasMasterDetail == true;
    var isTabularMasterDetail = ViewBag.IsTabularMasterDetail == true;
    var openMasterDetailId = ViewBag.OpenMasterDetailId as int?;
    var openMasterDetailNew = ViewBag.OpenMasterDetailNew == true;
    var pageModeClass = hasMasterDetail ? "module-page--transaction" : "module-page--master";
    var pageIcon = hasMasterDetail ? "fa-file-invoice" : "fa-database";
    var pageSubtitle = hasMasterDetail
        ? "Create and manage transaction documents with header and line items"
        : "Browse, create, and maintain master data records";
}

<div class="app-page-fill module-page @pageModeClass">
    <div class="page-header module-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="module-page-icon" aria-hidden="true"><i class="fa-solid @pageIcon"></i></span>
            <div>
                <h1 class="h3 mb-0">@form?.FormName</h1>
                <p class="page-subtitle mb-0">@pageSubtitle</p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 module-page-actions">
            @if (hasMasterDetail && perms?.CanCreate == true)
            {
                <button type="button" class="btn btn-primary" id="btnAddMasterDetail" title="New @form?.FormName" aria-label="New @form?.FormName">
                    <i class="fa-solid fa-plus me-1"></i>New @form?.FormName
                </button>
            }
            else if (!hasMasterDetail && perms?.CanCreate == true)
            {
                <button type="button" class="btn btn-primary" id="btnAdd" data-module="@formCode" data-entity="@form?.EntityName" title="Add New" aria-label="Add New">
                    <i class="fa-solid fa-plus me-1"></i>Add New
                </button>
            }
            @if (perms?.CanExport == true)
            {
                <a class="btn btn-outline-success" href="/api/metaforge/grid/@formCode/export/excel?Page=1&PageSize=1000" title="Export Excel" aria-label="Export Excel" data-no-progress>
                    <i class="fa-solid fa-file-excel me-1"></i>Excel
                </a>
                <a class="btn btn-outline-secondary" href="/api/metaforge/grid/@formCode/export/csv?Page=1&PageSize=1000" title="Export CSV" aria-label="Export CSV" data-no-progress>
                    <i class="fa-solid fa-file-csv me-1"></i>CSV
                </a>
            }
        </div>
    </div>

    @if (!hasMasterDetail && (perms?.CanCreate == true || perms?.CanEdit == true))
    {
        <div class="modal fade admin-modal module-record-modal" id="recordFormModal" tabindex="-1" aria-labelledby="recordFormModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="recordFormModalTitle">New Record</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="module-form-shell">
                            <form id="dynamicForm" class="master-detail-form" data-module="@formCode" data-entity="@form?.EntityName"></form>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark me-1"></i>Cancel
                        </button>
                        <button type="button" class="btn btn-primary" id="btnSave">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (hasMasterDetail && isTabularMasterDetail)
    {
        @await Html.PartialAsync("_MasterDetailTabularModal")
    }
    else if (hasMasterDetail)
    {
        @await Html.PartialAsync("_MasterDetailModal")
    }

    <div class="card admin-card admin-grid-card admin-grid-card--fill module-grid-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fa-solid fa-table me-2"></i>@(hasMasterDetail ? "Documents" : "Records")</span>
            <span class="text-muted small module-grid-hint">Use row actions to edit or remove entries</span>
        </div>
        <div class="card-body p-0">
            <table id="dynamicGrid" class="table table-sm table-striped table-hover w-100 mb-0"
                   data-module="@formCode"
                   data-entity="@grid?.Entity"
                   data-has-master-detail="@(hasMasterDetail ? "true" : "false")">
                <thead>
                    <tr>
                        @if (grid?.Columns != null)
                        {
                            @foreach (var col in grid.Columns)
                            {
                                <th data-property="@col.PropertyName">@col.Label</th>
                            }
                        }
                        @if (perms?.CanEdit == true || perms?.CanDelete == true || (hasMasterDetail && perms?.CanView == true))
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const formDef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(form));
            const gridDef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(grid));
            const permissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(perms));
            const formCode = '@formCode';
            const hasMasterDetail = @(hasMasterDetail ? "true" : "false");
            const isTabularMasterDetail = @(isTabularMasterDetail ? "true" : "false");

            DynamicGrid.init('#dynamicGrid', gridDef, permissions, hasMasterDetail);

            @if (!hasMasterDetail)
            {
                <text>
            const recordModal = new bootstrap.Modal('#recordFormModal');

            DynamicForm.init('#dynamicForm', formDef, { layoutClass: 'master-detail-form' });

            $('#btnAdd').on('click', function () {
                DynamicForm.showNew();
                $('#recordFormModalTitle').text('New Record');
                recordModal.show();
            });

            $('#btnSave').on('click', () => {
                DynamicForm.save()
                    .then(() => {
                        recordModal.hide();
                        DynamicForm.reset();
                        $('#recordFormModalTitle').text('New Record');
                    })
                    .fail(function (xhr) {
                        const msg = xhr.responseJSON?.error ?? xhr.responseText ?? xhr.statusText;
                        alert('Save failed: ' + msg);
                    });
            });

            $('#recordFormModal').on('hidden.bs.modal', () => DynamicForm.reset());
                </text>
            }
            else
            {
                <text>
            const openEntry = (recordId) => {
                const handler = isTabularMasterDetail ? MasterDetailTabular : MasterDetail;
                handler.loadAndOpen(formCode, recordId, permissions, {
                    onSaved: () => DynamicGrid.reload()
                });
            };

            $('#btnAddMasterDetail').on('click', () => openEntry(null));

            $('#dynamicGrid').on('click', '.btn-master-edit', function (e) {
                e.preventDefault();
                openEntry($(this).data('id'));
            });

            @if (openMasterDetailNew)
            {
                <text>
            openEntry(null);
                </text>
            }
            else if (openMasterDetailId.HasValue)
            {
                <text>
            openEntry(@openMasterDetailId.Value);
                </text>
            }
                </text>
            }
        });
    </script>
}
