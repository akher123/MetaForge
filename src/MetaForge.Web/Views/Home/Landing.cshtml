@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Home";
}

<section class="hero-section hero-section--simple">
    <div class="hero-bg" aria-hidden="true">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
    </div>
    <div class="container position-relative">
        <div class="hero-simple text-center">
            <div class="hero-badge">
                <i class="fa-brands fa-microsoft me-2"></i>
                .NET 10 &middot; ASP.NET Core MVC &middot; EF Core
            </div>
            <h1 class="hero-title">MetaForge</h1>
            <p class="hero-subtitle mx-auto">
                A metadata-driven admin platform. Define forms, grids, menus, and permissions in the database —
                then run CRUD and master-detail screens from your EF Core entities without building each view by hand.
            </p>
            <div class="hero-actions justify-content-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-hero-primary btn-lg">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                </a>
                <a href="#overview" class="btn btn-hero-outline btn-lg">Learn more</a>
            </div>
        </div>
    </div>
</section>

<section class="trust-strip">
    <div class="container">
        <div class="trust-strip-inner">
            <span class="trust-label">Built with</span>
            <ul class="trust-items">
                <li><i class="fa-solid fa-layer-group"></i> Clean Architecture</li>
                <li><i class="fa-solid fa-database"></i> SQL Server + EF Core</li>
                <li><i class="fa-solid fa-lock"></i> Cookie auth &amp; RBAC</li>
                <li><i class="fa-solid fa-code"></i> Dynamic Module UI</li>
            </ul>
        </div>
    </div>
</section>

<section id="overview" class="overview-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-eyebrow">Overview</span>
            <h2 class="section-title">What MetaForge provides</h2>
            <p class="section-subtitle">
                The platform is the framework; your business tables and screens are features you add on top.
            </p>
        </div>
        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-3">
                <article class="simple-card">
                    <div class="simple-card-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <h3>Dynamic UI</h3>
                    <p>Forms and grids render from <code>ForgeForm</code> and <code>ForgeField</code> metadata at runtime.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="simple-card">
                    <div class="simple-card-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                    <h3>Entity discovery</h3>
                    <p>Scan EF Core entities to bootstrap fields, relations, and columns in the Form Builder.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="simple-card">
                    <div class="simple-card-icon"><i class="fa-solid fa-diagram-project"></i></div>
                    <h3>Master-detail</h3>
                    <p>Header and line-item screens with lookups, validation, and atomic save.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-3">
                <article class="simple-card">
                    <div class="simple-card-icon"><i class="fa-solid fa-user-shield"></i></div>
                    <h3>Security</h3>
                    <p>Users, roles, and form-level permissions for view, create, edit, delete, and export.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section id="layers" class="layers-section">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-5">
                <span class="section-eyebrow">Solution</span>
                <h2 class="section-title">Project layers</h2>
                <p class="section-lead">
                    Dependencies point inward: Domain has no infrastructure references;
                    Web hosts MVC, the Form Builder, and the REST API.
                </p>
            </div>
            <div class="col-lg-7">
                <ul class="layer-list">
                    <li class="layer-item">
                        <span class="layer-name">MetaForge.Web</span>
                        <span class="layer-desc">MVC shell, dynamic modules, security UI, API</span>
                    </li>
                    <li class="layer-item">
                        <span class="layer-name">MetaForge.Infrastructure</span>
                        <span class="layer-desc">EF Core, repositories, generic CRUD, discovery</span>
                    </li>
                    <li class="layer-item">
                        <span class="layer-name">MetaForge.Application</span>
                        <span class="layer-desc">Interfaces, DTOs, service contracts</span>
                    </li>
                    <li class="layer-item layer-item--domain">
                        <span class="layer-name">MetaForge.Domain</span>
                        <span class="layer-desc">Metadata model, RBAC, audit, feature entities</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-card cta-card--simple">
            <div class="cta-content mx-auto text-center">
                <h2>Try the sample app</h2>
                <p>Sign in to explore modules, the Form Builder, and the included ERP demo data.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-cta-primary btn-lg">
                    <i class="fa-solid fa-gauge-high me-2"></i>Open Dashboard
                </a>
                <p class="demo-credentials">
                    Demo: <code>admin</code> / <code>admin</code>
                </p>
            </div>
        </div>
    </div>
</section>
