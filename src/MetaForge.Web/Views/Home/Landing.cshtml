<section class="trust-strip">
    <div class="container">
        <div class="trust-strip-inner">
            <span class="trust-label">Platform stack</span>
            <ul class="trust-items">
                <li><i class="fa-brands fa-microsoft"></i> ASP.NET Core MVC</li>
                <li><i class="fa-solid fa-database"></i> Entity Framework Core</li>
                <li><i class="fa-solid fa-lock"></i> Cookie Auth + RBAC</li>
                <li><i class="fa-solid fa-code-branch"></i> Clean Architecture</li>
            </ul>
        </div>
    </div>
</section>

<section id="features" class="features-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-eyebrow">Capabilities</span>
            <h2 class="section-title">Everything you need for back-office operations</h2>
            <p class="section-subtitle">One metadata layer powers forms, grids, navigation, security, and exports.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
                    <h3>Dynamic Forms</h3>
                    <p>Render text, dropdown, date, checkbox, and textarea controls from <code>ForgeField</code> metadata with validation rules applied at runtime.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon feature-icon-cyan"><i class="fa-solid fa-table"></i></div>
                    <h3>Data Grids</h3>
                    <p>Paging, sorting, search, and Excel/CSV export driven by configurable grid columns — no per-entity view code required.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon feature-icon-violet"><i class="fa-solid fa-diagram-project"></i></div>
                    <h3>Master-Detail</h3>
                    <p>One-to-many transaction screens with inline detail lines, lookups, and atomic save for header and detail records.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon feature-icon-emerald"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                    <h3>Entity Discovery</h3>
                    <p>Scan EF Core feature entities under <code>MetaForge.Domain.Features</code> to bootstrap forms, relations, and grid columns automatically.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon feature-icon-amber"><i class="fa-solid fa-user-shield"></i></div>
                    <h3>Role-Based Security</h3>
                    <p>Users, roles, and permissions with form-level gates for view, create, edit, delete, export, and approve actions.</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="feature-card">
                    <div class="feature-icon feature-icon-rose"><i class="fa-solid fa-hammer"></i></div>
                    <h3>Form Builder</h3>
                    <p>Design master and transaction modules, sync navigation menus, and preview screens before publishing to users.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<section id="architecture" class="architecture-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="section-eyebrow">Architecture</span>
                <h2 class="section-title">Clean layers, metadata at the center</h2>
                <p class="section-lead">
                    MetaForge follows Clean Architecture with a dedicated metadata model.
                    Business entities stay in Domain; infrastructure handles persistence and dynamic CRUD;
                    the Web layer renders screens from cached form definitions.
                </p>
                <ul class="architecture-list">
                    <li><i class="fa-solid fa-circle-check"></i> <strong>MetaForge.Domain</strong> — entities, <code>ForgeForm</code>, security model</li>
                    <li><i class="fa-solid fa-circle-check"></i> <strong>MetaForge.Application</strong> — interfaces, DTOs, contracts</li>
                    <li><i class="fa-solid fa-circle-check"></i> <strong>MetaForge.Infrastructure</strong> — EF Core, services, repositories</li>
                    <li><i class="fa-solid fa-circle-check"></i> <strong>MetaForge.Web</strong> — MVC modules, REST API, authorization</li>
                </ul>
            </div>
            <div class="col-lg-7">
                <div class="architecture-diagram">
                    <div class="arch-layer arch-layer-web">
                        <span class="arch-label">Presentation</span>
                        <span class="arch-name">MetaForge.Web</span>
                        <span class="arch-detail">ModuleController · Form Builder · /api/metaforge</span>
                    </div>
                    <div class="arch-connector"><i class="fa-solid fa-arrow-down"></i></div>
                    <div class="arch-layer arch-layer-app">
                        <span class="arch-label">Application</span>
                        <span class="arch-name">MetaForge.Application</span>
                        <span class="arch-detail">IFormMetadataService · IGenericCrudService · IGridService</span>
                    </div>
                    <div class="arch-connector"><i class="fa-solid fa-arrow-down"></i></div>
                    <div class="arch-row">
                        <div class="arch-layer arch-layer-infra">
                            <span class="arch-label">Infrastructure</span>
                            <span class="arch-name">MetaForge.Infrastructure</span>
                            <span class="arch-detail">MetaForgeDbContext · Discovery · Dynamic CRUD</span>
                        </div>
                        <div class="arch-layer arch-layer-domain">
                            <span class="arch-label">Domain</span>
                            <span class="arch-name">MetaForge.Domain</span>
                            <span class="arch-detail">Business · ForgeForm · RBAC</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="how-it-works" class="steps-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-eyebrow">Workflow</span>
            <h2 class="section-title">From entity to live module in three steps</h2>
        </div>
        <div class="steps-track">
            <div class="step-card">
                <div class="step-number">1</div>
                <div class="step-icon"><i class="fa-solid fa-cubes"></i></div>
                <h3>Discover entity</h3>
                <p>Select a business entity from EF Core metadata or register it in the Form Builder with a module group.</p>
            </div>
            <div class="step-connector" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="step-card">
                <div class="step-number">2</div>
                <div class="step-icon"><i class="fa-solid fa-sliders"></i></div>
                <h3>Configure metadata</h3>
                <p>Define fields, grid columns, lookups, relations, and permissions. Preview the screen before go-live.</p>
            </div>
            <div class="step-connector" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
            <div class="step-card">
                <div class="step-number">3</div>
                <div class="step-icon"><i class="fa-solid fa-rocket"></i></div>
                <h3>Publish module</h3>
                <p>The module appears in navigation instantly. Users perform CRUD, exports, and master-detail workflows.</p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-card">
            <div class="cta-content">
                <h2>Ready to forge your admin platform?</h2>
                <p>Sign in to configure modules, manage security, and explore the sample ERP data set.</p>
                <div class="cta-actions">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-cta-primary btn-lg">
                        <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In to Dashboard
                    </a>
                </div>
                <p class="demo-credentials">
                    <i class="fa-solid fa-key me-1"></i>
                    Demo credentials: <code>admin</code> / <code>admin</code>
                </p>
            </div>
            <div class="cta-visual" aria-hidden="true">
                <div class="cta-icon-ring">
                    <i class="fa-solid fa-bolt"></i>
                </div>
            </div>
        </div>
    </div>
</section>
