@model MetaForge.Web.Models.CulturePickerViewModel
@using MetaForge.Shared.Culture
@{
    var inheritValue = "";
    var selectedCulture = Model.UserCultureOverride ?? inheritValue;
    var selectedDateFormat = Model.UserDateFormatOverride ?? inheritValue;
    var selectedDateTimeFormat = Model.UserDateTimeFormatOverride ?? inheritValue;
    var hasOverrides = Model.CultureIsUserOverride || Model.DateFormatIsUserOverride || Model.DateTimeFormatIsUserOverride;
}
<div class="culture-picker" data-culture-picker>
    <div class="culture-picker-header">
        <div class="culture-picker-header-text">
            <h2 class="culture-picker-title">
                <i class="fa-solid fa-globe" aria-hidden="true"></i>
                @Localizer["Culture_LanguageRegion"]
            </h2>
            <p class="culture-picker-subtitle">
                @Localizer["Culture_Subtitle"]
                @if (Model.CultureIsUserOverride || Model.DateFormatIsUserOverride || Model.DateTimeFormatIsUserOverride)
                {
                    <span class="culture-picker-override-badge">@Localizer["Culture_Custom"]</span>
                }
                else
                {
                    <span class="culture-picker-override-badge culture-picker-override-badge--inherit">@Localizer["Culture_SystemDefault"]</span>
                }
            </p>
        </div>
        <span class="culture-picker-status" id="culturePickerStatus" aria-live="polite" hidden>
            <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
            <span>@Localizer["Culture_Saving"]</span>
        </span>
    </div>

    <div class="culture-picker-controls">
        <label class="form-label" for="culturePickerSelect">@Localizer["Culture_CultureLabel"]</label>
        <select id="culturePickerSelect"
                class="form-select culture-picker-select"
                data-effective-culture="@Model.EffectiveCulture"
                data-system-default="@Model.SystemDefaultCulture"
                data-selected="@selectedCulture"
                aria-describedby="culturePickerHint">
            <option value="@inheritValue" selected="@(string.IsNullOrEmpty(Model.UserCultureOverride) ? "selected" : null)">
                @Localizer["Culture_UseSystemDefault", Model.SystemDefaultCulture]
            </option>
            @foreach (var culture in Model.Cultures)
            {
                <option value="@culture.Name" selected="@(string.Equals(culture.Name, Model.UserCultureOverride, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                    @culture.DisplayName (@culture.Name)
                </option>
            }
        </select>
        <div id="culturePickerHint" class="form-text">
            @Localizer["Culture_SystemDefaultHint", Model.SystemDefaultCulture]
        </div>
    </div>

    <div class="culture-picker-controls">
        <label class="form-label" for="dateFormatPickerSelect">@Localizer["Culture_DateFormat"]</label>
        <select id="dateFormatPickerSelect"
                class="form-select culture-picker-select"
                data-effective-format="@Model.EffectiveDateFormat"
                data-system-default="@Model.SystemDefaultDateFormat"
                data-selected="@selectedDateFormat">
            <option value="@inheritValue" selected="@(string.IsNullOrEmpty(Model.UserDateFormatOverride) ? "selected" : null)">
                @Localizer["Culture_UseSystemDefaultShort"]
            </option>
        </select>
        @if (Model.DateFormatIsUserOverride)
        {
            <div class="form-text">@Localizer["Culture_CustomDateFormat"]</div>
        }
    </div>

    <div class="culture-picker-controls">
        <label class="form-label" for="dateTimeFormatPickerSelect">@Localizer["Culture_DateTimeFormat"]</label>
        <select id="dateTimeFormatPickerSelect"
                class="form-select culture-picker-select"
                data-effective-format="@Model.EffectiveDateTimeFormat"
                data-system-default="@Model.SystemDefaultDateTimeFormat"
                data-selected="@selectedDateTimeFormat">
            <option value="@inheritValue" selected="@(string.IsNullOrEmpty(Model.UserDateTimeFormatOverride) ? "selected" : null)">
                @Localizer["Culture_UseSystemDefaultShort"]
            </option>
        </select>
        @if (Model.DateTimeFormatIsUserOverride)
        {
            <div class="form-text">@Localizer["Culture_CustomDateTimeFormat"]</div>
        }
    </div>

    <div class="culture-preview" id="culturePreviewPanel" aria-live="polite" @(Model.ShowInlinePreview ? null : "hidden")>
        <h3 class="culture-preview-title">@Localizer["Culture_FormatPreview"]</h3>
        <dl class="culture-preview-list">
            <div class="culture-preview-item">
                <dt>@Localizer["Culture_Date"]</dt>
                <dd id="culturePreviewDate">@Model.Preview.ShortDate</dd>
            </div>
            <div class="culture-preview-item">
                <dt>@Localizer["Culture_DateTime"]</dt>
                <dd id="culturePreviewDateTime">@Model.Preview.ShortDateTime</dd>
            </div>
            <div class="culture-preview-item">
                <dt>@Localizer["Culture_Number"]</dt>
                <dd id="culturePreviewNumber">@Model.Preview.SampleNumber</dd>
            </div>
        </dl>
    </div>

    <div class="culture-picker-actions">
        <button type="button"
                class="btn btn-outline-secondary btn-sm"
                id="culturePickerResetBtn"
                @(!hasOverrides ? "disabled" : null)>
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            @Localizer["Culture_Reset"]
        </button>
        <p class="culture-picker-actions-hint">
            @Localizer["Culture_ResetHint"]
        </p>
    </div>
</div>
