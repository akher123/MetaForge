@using System.Security.Claims
@using MetaForge.Shared.Constants
@using MetaForge.Shared.Culture
@using MetaForge.Web.Localization
@using MetaForge.Web.Middleware
@inject MetaForge.Application.Interfaces.INavigationService NavigationService
@inject MetaForge.Application.Interfaces.IUserPreferenceService UserPreferenceService
@inject MetaForge.Application.Interfaces.ISystemSettingsService SystemSettingsService
@{
    var sidebarMenu = await NavigationService.GetSidebarMenuAsync();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    string userThemeKey = AppThemes.Default;
    var themeIsDark = false;
    if (isAuthenticated && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var themeUserId))
    {
        userThemeKey = await UserPreferenceService.GetThemeAsync(themeUserId);
        themeIsDark = AppThemes.IsDark(userThemeKey);
    }
    var availableThemes = UserPreferenceService.GetAvailableThemes();
    var themePickerModel = new ThemePickerViewModel
    {
        ActiveThemeKey = userThemeKey,
        Themes = availableThemes,
        Variant = "panel",
        GridId = "themePickerGridNav"
    };
    var activeThemeName = availableThemes.FirstOrDefault(t =>
        string.Equals(t.Key, userThemeKey, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? "Theme";

    var effectiveCulture = Context.Items[CultureMiddleware.EffectiveCultureItemKey] as string ?? "en-US";
    var clientStrings = LocalizationServiceCollectionExtensions.GetClientStrings(Localizer);
    var isRtl = Context.Items[CultureMiddleware.IsRtlItemKey] as bool? ?? false;
    var systemLocalization = await SystemSettingsService.GetLocalizationAsync();
    var systemDefaultCulture = systemLocalization.DefaultCulture;
    var effectiveDateFormat = DisplayFormatContext.Preferences?.DateFormat ?? systemLocalization.DefaultDateFormat;
    var effectiveDateTimeFormat = DisplayFormatContext.Preferences?.DateTimeFormat ?? systemLocalization.DefaultDateTimeFormat;
}
<!DOCTYPE html>
<html lang="@effectiveCulture" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@userThemeKey" data-bs-theme="@(themeIsDark ? "dark" : "light")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - MetaForge</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/datatables-bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-progress.css" asp-append-version="true" />
    <script>
        window.__METAFORGE_THEME__ = {
            key: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userThemeKey)),
            isDark: @(themeIsDark ? "true" : "false"),
            authenticated: @(isAuthenticated ? "true" : "false")
        };
        window.__METAFORGE_LOCALE__ = {
            culture: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(effectiveCulture)),
            isRtl: @(isRtl ? "true" : "false"),
            systemDefaultCulture: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(systemDefaultCulture)),
            dateFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(effectiveDateFormat)),
            dateTimeFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(effectiveDateTimeFormat)),
            authenticated: @(isAuthenticated ? "true" : "false"),
            strings: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clientStrings))
        };
        try {
            if (!window.__METAFORGE_THEME__.authenticated) {
                var stored = localStorage.getItem('metaforge.theme');
                if (stored) {
                    document.documentElement.setAttribute('data-theme', stored);
                    document.documentElement.setAttribute('data-bs-theme', stored.indexOf('dark') >= 0 ? 'dark' : 'light');
                    window.__METAFORGE_THEME__.key = stored;
                }
            }
        } catch (_) { /* ignore */ }
    </script>
    @if (isAuthenticated && sidebarMenu.Count > 0)
    {
        <script>
            try {
                if (window.matchMedia('(min-width: 992px)').matches
                    && localStorage.getItem('metaforge.sidebar.collapsed') === '1') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (_) { /* ignore */ }
        </script>
    }
</head>
<body class="metaforge-app">
    <a href="#main-content" class="mf-skip-link">@Localizer["Common_SkipToMainContent"]</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar" aria-label="Application">
            <div class="container-fluid app-navbar-inner">
                <div class="app-navbar-start">
                    @if (isAuthenticated && sidebarMenu.Count > 0)
                    {
                        <button type="button"
                                class="sidebar-collapse-toggle d-none d-lg-inline-flex"
                                id="sidebarCollapseToggle"
                                aria-controls="sidebarNav"
                                aria-expanded="true"
                                aria-label="@Localizer["Nav_CollapseSidebar"]"
                                title="@Localizer["Nav_CollapseSidebar"]">
                            <span class="sidebar-hamburger" aria-hidden="true">
                                <span class="sidebar-hamburger-line"></span>
                                <span class="sidebar-hamburger-line"></span>
                                <span class="sidebar-hamburger-line"></span>
                            </span>
                        </button>
                        <button class="navbar-toggler app-navbar-toggler d-lg-none"
                                type="button"
                                id="sidebarMobileToggle"
                                aria-controls="sidebarNav"
                                aria-expanded="false"
                                aria-label="@Localizer["Nav_OpenNavigation"]"
                                data-label-open="@Localizer["Nav_OpenNavigation"]"
                                data-label-close="@Localizer["Nav_CloseNavigation"]">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                    }
                    <a class="navbar-brand" asp-controller="Home" asp-action="Dashboard">
                        Meta<span>Forge</span>
                    </a>
                </div>

                <div class="app-navbar-end">
                    @if (isAuthenticated)
                    {
                        <div class="app-navbar-actions">
                            <ul class="navbar-nav align-items-center">
                                <li class="nav-item dropdown app-theme-menu">
                                    <button type="button"
                                            class="app-theme-trigger"
                                            id="appThemeTrigger"
                                            data-bs-toggle="dropdown"
                                            data-bs-auto-close="outside"
                                            aria-expanded="false"
                                            aria-haspopup="listbox"
                                            aria-label="@Localizer["Nav_ChangeTheme", activeThemeName]"
                                            title="@Localizer["Nav_AppearanceTitle", activeThemeName]">
                                        <span class="app-theme-trigger-icon" aria-hidden="true">
                                            <i class="fa-solid fa-palette"></i>
                                        </span>
                                        <span class="app-theme-trigger-label d-none d-xl-inline">@activeThemeName</span>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end app-theme-panel" aria-labelledby="appThemeTrigger">
                                        @await Html.PartialAsync("_ThemePicker", themePickerModel)
                                    </div>
                                </li>
                                <li class="nav-item dropdown app-user-menu">
                                    <button type="button"
                                            class="app-user-trigger dropdown-toggle"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="@Localizer["Nav_AccountMenu", User.Identity?.Name ?? string.Empty]">
                                        <span class="app-user-avatar" aria-hidden="true">
                                            <i class="fa-solid fa-user"></i>
                                        </span>
                                        <span class="app-user-name d-none d-md-inline">@User.Identity!.Name</span>
                                        <i class="fa-solid fa-chevron-down app-user-chevron d-none d-md-inline" aria-hidden="true"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end app-user-dropdown">
                                        <div class="app-user-dropdown-header">
                                            <span class="app-user-dropdown-avatar" aria-hidden="true">
                                                <i class="fa-solid fa-user"></i>
                                            </span>
                                            <div class="app-user-dropdown-meta">
                                                <span class="app-user-dropdown-name">@User.Identity!.Name</span>
                                                <span class="app-user-dropdown-status">@Localizer["Common_SignedIn"]</span>
                                            </div>
                                        </div>
                                        <div class="dropdown-divider app-user-dropdown-divider"></div>
                                        <a class="app-user-dropdown-link" asp-controller="Account" asp-action="Preferences">
                                            <span class="app-user-dropdown-link-icon" aria-hidden="true">
                                                <i class="fa-solid fa-sliders"></i>
                                            </span>
                                            <span class="app-user-dropdown-link-text">
                                                <span class="app-user-dropdown-link-label">@Localizer["Nav_Preferences"]</span>
                                                <span class="app-user-dropdown-link-hint">@Localizer["Nav_PreferencesHint"]</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-right app-user-dropdown-link-chevron" aria-hidden="true"></i>
                                        </a>
                                        <a class="app-user-dropdown-link" asp-controller="Account" asp-action="Appearance">
                                            <span class="app-user-dropdown-link-icon" aria-hidden="true">
                                                <i class="fa-solid fa-palette"></i>
                                            </span>
                                            <span class="app-user-dropdown-link-text">
                                                <span class="app-user-dropdown-link-label">@Localizer["Nav_Appearance"]</span>
                                                <span class="app-user-dropdown-link-hint">@Localizer["Nav_AppearanceHint"]</span>
                                            </span>
                                            <i class="fa-solid fa-chevron-right app-user-dropdown-link-chevron" aria-hidden="true"></i>
                                        </a>
                                        <div class="dropdown-divider app-user-dropdown-divider"></div>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="app-user-signout-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="app-user-signout-btn">
                                                <span class="app-user-signout-icon" aria-hidden="true">
                                                    <i class="fa-solid fa-right-from-bracket"></i>
                                                </span>
                                                <span class="app-user-signout-text">
                                                    <span class="app-user-signout-label">@Localizer["Nav_SignOut"]</span>
                                                    <span class="app-user-signout-hint">@Localizer["Nav_SignOutHint"]</span>
                                                </span>
                                            </button>
                                        </form>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </nav>
        <div id="topProgress" class="top-progress" aria-hidden="true" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@Localizer["Nav_PageLoading"]">
            <div id="topProgressBar" class="top-progress-bar"></div>
        </div>
    </header>

    <div class="app-layout">
        @if (isAuthenticated && sidebarMenu.Count > 0)
        {
            <div class="app-sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>
            <aside class="app-sidebar-wrapper app-sidebar-drawer" id="sidebarNav">
                @await Html.PartialAsync("_SidebarMenu", sidebarMenu)
            </aside>
        }
        <div class="app-content">
            @await Html.PartialAsync("_AppAlerts")
            <main id="main-content" role="main" class="app-main" tabindex="-1">
                @RenderBody()
            </main>
            <footer class="app-footer py-3">
                <div class="app-footer-inner text-center">
                    <span class="app-footer-full">@Localizer["Footer_Copyright"]</span>
                    <span class="app-footer-short">@Localizer["Footer_CopyrightShort"]</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/metaforge/datatables-defaults.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/metaforge/icons.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/form-permissions.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/lookup-cascade.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/field-conditional-engine.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/control-types.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="~/js/metaforge/rich-text-editor.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/dynamic-form.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/grid-display-format.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/date-input.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/dynamic-grid.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/detail-grid-rows.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/master-detail.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/master-detail-tabular.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/theme.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/locale.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/sidebar-menu.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/top-progress.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/ui-feedback.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ConfirmDeleteModal")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
