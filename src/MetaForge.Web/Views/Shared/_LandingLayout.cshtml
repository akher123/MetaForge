@using MetaForge.Web.Localization
@using MetaForge.Web.Middleware
@{
    var effectiveCulture = Context.Items[CultureMiddleware.EffectiveCultureItemKey] as string ?? "en-US";
    var isRtl = Context.Items[CultureMiddleware.IsRtlItemKey] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="@effectiveCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MetaForge — metadata-driven ASP.NET Core admin framework for .NET 10. Ship CRUD, master-detail, reports, and security from EF Core entities and database metadata." />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - MetaForge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-progress.css" asp-append-version="true" />
</head>
<body class="landing-body">
    <a href="#main-content" class="mf-skip-link">@Localizer["Common_SkipToMainContent"]</a>

    <header class="landing-header">
        <nav class="navbar navbar-expand-lg landing-nav" aria-label="Primary">
            <div class="container">
                <a class="navbar-brand landing-brand" asp-controller="Home" asp-action="Landing" aria-label="MetaForge home">
                    <span class="landing-brand-mark" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
                    <span class="landing-brand-text">Meta<span class="landing-brand-accent">Forge</span></span>
                </a>
                <button class="navbar-toggler landing-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#landingNav" aria-controls="landingNav" aria-expanded="false" aria-label="@Localizer["Landing_ToggleNavigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="landingNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" href="#capabilities">@Localizer["Landing_Capabilities"]</a></li>
                        <li class="nav-item"><a class="nav-link" href="#platform">@Localizer["Landing_Platform"]</a></li>
                        <li class="nav-item"><a class="nav-link" href="#architecture">@Localizer["Landing_Architecture"]</a></li>
                        <li class="nav-item"><a class="nav-link" href="#get-started">@Localizer["Landing_GetStarted"]</a></li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-signin" asp-controller="Account" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-2" aria-hidden="true"></i>@Localizer["Landing_SignIn"]
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div id="topProgress" class="top-progress" aria-hidden="true" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@Localizer["Nav_PageLoading"]">
            <div id="topProgressBar" class="top-progress-bar"></div>
        </div>
    </header>

    <main id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="landing-footer" role="contentinfo">
        <div class="container">
            <div class="landing-footer-grid">
                <div class="landing-footer-col landing-footer-col--brand">
                    <div class="landing-footer-brand">
                        <span class="landing-brand-mark landing-brand-mark-sm" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
                        <span>MetaForge</span>
                    </div>
                    <p class="landing-footer-tagline">
                        @Localizer["Landing_FooterTagline"]
                    </p>
                </div>
                <div class="landing-footer-col">
                    <h3 class="landing-footer-heading">@Localizer["Landing_Platform"]</h3>
                    <ul class="landing-footer-links">
                        <li><a href="#capabilities">@Localizer["Landing_Capabilities"]</a></li>
                        <li><a href="#platform">@Localizer["Landing_ScreenTypes"]</a></li>
                        <li><a href="#architecture">@Localizer["Landing_Architecture"]</a></li>
                    </ul>
                </div>
                <div class="landing-footer-col">
                    <h3 class="landing-footer-heading">@Localizer["Landing_GetStarted"]</h3>
                    <ul class="landing-footer-links">
                        <li><a asp-controller="Account" asp-action="Login">@Localizer["Auth_SignIn"]</a></li>
                        <li><a href="#get-started">@Localizer["Landing_DemoApplication"]</a></li>
                    </ul>
                </div>
            </div>
            <div class="landing-footer-bottom">
                <p class="landing-footer-copy mb-0">&copy; @DateTime.UtcNow.Year MetaForge. @Localizer["Landing_FooterBuiltWith"]</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/metaforge/top-progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
