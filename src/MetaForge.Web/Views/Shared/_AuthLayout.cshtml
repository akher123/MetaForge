@using MetaForge.Web.Middleware
@{
    var effectiveCulture = Context.Items[CultureMiddleware.EffectiveCultureItemKey] as string ?? "en-US";
    var isRtl = Context.Items[CultureMiddleware.IsRtlItemKey] as bool? ?? false;
}
<!DOCTYPE html>
<html lang="@effectiveCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="Sign in to MetaForge — metadata-driven ASP.NET Core admin platform." />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - MetaForge</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-progress.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <a href="#main-content" class="mf-skip-link">@Localizer["Common_SkipToMainContent"]</a>

    <div id="topProgress" class="top-progress top-progress--auth" aria-hidden="true" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="@Localizer["Nav_PageLoading"]">
        <div id="topProgressBar" class="top-progress-bar"></div>
    </div>

    <main id="main-content" class="auth-main" tabindex="-1">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/metaforge/top-progress.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/metaforge/auth.js" asp-append-version="true"></script>
</body>
</html>
