@{
    ViewData["Title"] = ViewBag.Form?.FormName ?? "Admin";
    var form = ViewBag.Form as MetaForge.Application.DTOs.FormDefinition;
    var grid = ViewBag.Grid as MetaForge.Application.DTOs.GridDefinition;
    var formCode = ViewBag.FormCode as string;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.FormPermissionsDto;
    var hasMasterDetail = ViewBag.HasMasterDetail == true;
    var isTabularMasterDetail = ViewBag.IsTabularMasterDetail == true;
    var isTabbedForm = ViewBag.IsTabbedForm == true;
    var openMasterDetailId = ViewBag.OpenMasterDetailId as string;
    var openMasterDetailNew = ViewBag.OpenMasterDetailNew == true;
    var rowCustomActions = grid?.Actions?.Where(a => string.Equals(a.Placement, "Row", StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
    var showActionsColumn = perms?.CanView == true || perms?.CanEdit == true || perms?.CanDelete == true || rowCustomActions.Count > 0;
    var canOpenRecordForm = perms?.CanCreate == true || perms?.CanEdit == true || perms?.CanView == true;
    var canSaveRecordForm = perms?.CanCreate == true || perms?.CanEdit == true;
    var pageModeClass = hasMasterDetail
        ? "module-page--transaction"
        : isTabbedForm
            ? "module-page--tabbed"
            : "module-page--master";
    var breadcrumbPage = openMasterDetailNew ? "New Entry" : !string.IsNullOrWhiteSpace(openMasterDetailId) ? "Edit Entry" : null;
}

<div class="app-page-fill module-page @pageModeClass">
    @if (!hasMasterDetail && canOpenRecordForm)
    {
        <div class="modal fade admin-modal module-record-modal @(isTabbedForm ? "module-record-modal--tabbed" : "")" id="recordFormModal" tabindex="-1" aria-labelledby="recordFormModalTitle" aria-hidden="true">
            <div class="modal-dialog @(isTabbedForm ? "modal-xl" : "modal-lg") modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="recordFormModalTitle">New @form?.FormName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (isTabbedForm)
                        {
                            <p class="module-tabbed-form-hint small text-muted mb-2 mb-md-3">
                                <i class="fa-solid fa-folder-tree me-1" aria-hidden="true"></i>
                                Use the tabs below to move between sections. Required fields are marked with <span class="required-mark">*</span>.
                            </p>
                        }
                        <div class="module-form-shell">
                            <form id="dynamicForm" class="master-detail-form" data-module="@formCode" data-entity="@form?.EntityName"></form>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark me-1"></i>Cancel
                        </button>
                        @if (canSaveRecordForm)
                        {
                            <button type="button" class="btn btn-primary" id="btnSave">
                                <i class="fa-solid fa-floppy-disk me-1"></i>Save
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (hasMasterDetail && isTabularMasterDetail)
    {
        @await Html.PartialAsync("_MasterDetailTabularModal")
    }
    else if (hasMasterDetail)
    {
        @await Html.PartialAsync("_MasterDetailModal")
    }

    <div class="card admin-card admin-grid-card admin-grid-card--fill module-grid-card">
        <div class="card-header module-grid-card-header d-flex align-items-center flex-wrap gap-2">
            <div class="module-grid-breadcrumb">
                @await Component.InvokeAsync("Breadcrumb", new { currentPage = breadcrumbPage })
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 module-grid-toolbar">
                <span id="moduleGridToolbarActions" class="d-flex flex-wrap gap-2"></span>
                @if (hasMasterDetail && perms?.CanCreate == true)
                {
                    <button type="button" class="btn btn-sm btn-primary" id="btnAddMasterDetail" title="New @form?.FormName" aria-label="New @form?.FormName">
                        <i class="fa-solid fa-plus me-1"></i>New @form?.FormName
                    </button>
                }
                else if (!hasMasterDetail && perms?.CanCreate == true)
                {
                    <button type="button" class="btn btn-sm btn-primary" id="btnAdd" data-module="@formCode" data-entity="@form?.EntityName" title="Add New" aria-label="Add New">
                        <i class="fa-solid fa-plus me-1"></i>Add New
                    </button>
                }
                @if (perms?.CanExport == true)
                {
                    <a class="btn btn-sm btn-export-excel" href="/api/metaforge/grid/@formCode/export/excel?Page=1&PageSize=1000" title="Export Excel" aria-label="Export Excel" data-no-progress>
                        <i class="fa-solid fa-file-excel me-1"></i>Excel
                    </a>
                    <a class="btn btn-sm btn-export-csv" href="/api/metaforge/grid/@formCode/export/csv?Page=1&PageSize=1000" title="Export CSV" aria-label="Export CSV" data-no-progress>
                        <i class="fa-solid fa-file-csv me-1"></i>CSV
                    </a>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <table id="dynamicGrid" class="table table-sm table-striped table-hover table-bordered w-100 mb-0"
                   data-module="@formCode"
                   data-entity="@grid?.Entity"
                   data-has-master-detail="@(hasMasterDetail ? "true" : "false")">
                <thead class="table-light">
                    <tr>
                        @if (grid?.Columns != null)
                        {
                            @foreach (var col in grid.Columns)
                            {
                                <th data-property="@col.PropertyName">@col.Label</th>
                            }
                        }
                        @if (showActionsColumn)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const formDef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(form));
            const gridDef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(grid));
            const permissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(perms));
            const formCode = '@formCode';
            const formName = formDef?.FormName ?? formDef?.formName ?? 'Record';
            const hasMasterDetail = @(hasMasterDetail ? "true" : "false");
            const isTabularMasterDetail = @(isTabularMasterDetail ? "true" : "false");
            const isTabbedForm = @(isTabbedForm ? "true" : "false");
            const recordPerms = MetaForgePermissions.createApi(permissions);

            function setRecordModalTitle(isEdit) {
                const readOnly = isEdit && !recordPerms.canEdit();
                $('#recordFormModalTitle').text(
                    isEdit
                        ? (readOnly ? `View ${formName}` : `Edit ${formName}`)
                        : `New ${formName}`);
            }

            function applyRecordFormPermissions(isEdit) {
                const readOnly = isEdit ? !recordPerms.canEdit() : !recordPerms.canCreate();
                $('#dynamicForm :input').prop('disabled', readOnly);
                $('#btnSave').toggleClass('d-none', readOnly || (isEdit ? !recordPerms.canEdit() : !recordPerms.canCreate()));
            }

            DynamicGrid.init('#dynamicGrid', gridDef, permissions, hasMasterDetail);

            @if (!hasMasterDetail)
            {
                <text>
            const recordModal = new bootstrap.Modal('#recordFormModal');

            DynamicForm.init('#dynamicForm', formDef, {
                layoutClass: 'master-detail-form',
                layout: isTabbedForm ? 'tabs' : 'sections'
            });

            $('#btnAdd').on('click', function () {
                DynamicForm.showNew();
                setRecordModalTitle(false);
                applyRecordFormPermissions(false);
                recordModal.show();
            });

            $('#btnSave').on('click', () => {
                DynamicForm.save()
                    .then(() => {
                        recordModal.hide();
                        DynamicForm.reset();
                        setRecordModalTitle(false);
                    });
            });

            $('#recordFormModal').on('hidden.bs.modal', () => DynamicForm.reset());
                </text>
            }
            else
            {
                <text>
            const openEntry = (recordId) => {
                const handler = isTabularMasterDetail ? MasterDetailTabular : MasterDetail;
                handler.loadAndOpen(formCode, recordId, permissions, {
                    onSaved: () => DynamicGrid.reload()
                });
            };

            $('#btnAddMasterDetail').on('click', () => openEntry(null));

            $('#dynamicGrid').on('click', '.btn-master-edit', function (e) {
                e.preventDefault();
                openEntry($(this).data('id'));
            });

            @if (openMasterDetailNew)
            {
                <text>
            openEntry(null);
                </text>
            }
            else if (!string.IsNullOrWhiteSpace(openMasterDetailId))
            {
                <text>
            openEntry(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(openMasterDetailId)));
                </text>
            }
                </text>
            }
        });
    </script>
}
