@{
    ViewData["ScriptBundles"] = new[] { "Forms" };
    ViewData["Title"] = ViewBag.Form?.FormName ?? "Form";
    var form = ViewBag.Form as MetaForge.Application.DTOs.FormDefinition;
    var formCode = ViewBag.FormCode as string;
    var recordId = ViewBag.RecordId as string;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.FormPermissionsDto;
    var isEdit = !string.IsNullOrWhiteSpace(recordId);
    var canSave = isEdit ? perms?.CanEdit == true : perms?.CanCreate == true;
    var isReadOnly = isEdit ? perms?.CanEdit != true : perms?.CanCreate != true;
}

<div class="module-page module-page--master">
    <div class="page-header module-page-header d-flex align-items-center flex-wrap gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <span class="module-page-icon" aria-hidden="true"><i class="fa-solid fa-database"></i></span>
            <div>
                <h1 class="h3 mb-0">@form?.FormName</h1>
                @await Component.InvokeAsync("Breadcrumb", new { currentPage = isEdit ? "Edit" : "Create", requestPath = $"/Modules/{formCode}" })
            </div>
        </div>
    </div>

    <div class="card admin-card module-form-card">
        <div class="card-header">
            <i class="fa-solid fa-pen-to-square me-2"></i>@(isEdit ? $"Edit {form?.FormName}" : $"New {form?.FormName}")
        </div>
        <div class="card-body">
            <div class="module-form-shell">
                <form id="dynamicForm" class="master-detail-form" data-module="@formCode" data-entity="@form?.EntityName" data-id="@recordId"></form>
            </div>
            <div class="module-form-actions d-flex flex-wrap gap-2 mt-4">
                @if (canSave)
                {
                    <button type="button" class="btn btn-primary" id="btnSave">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Save
                    </button>
                }
                <a class="btn btn-outline-secondary" href="/Modules/@formCode">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const formDef = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(form));
            const recordId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(recordId));
            const isReadOnly = @(isReadOnly ? "true" : "false");
            DynamicForm.init('#dynamicForm', formDef, { layoutClass: 'master-detail-form' });
            if (recordId) {
                DynamicForm.load(recordId).then(function () {
                    if (isReadOnly) {
                        $('#dynamicForm :input').prop('disabled', true);
                    }
                });
            }
            const $btnSave = $('#btnSave');
            if ($btnSave.length) {
                $btnSave.on('click', () => {
                    DynamicForm.save()
                        .then(() => window.location = '/Modules/@formCode');
                });
            }
        });
    </script>
}
