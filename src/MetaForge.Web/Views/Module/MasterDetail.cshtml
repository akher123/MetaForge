@{
    ViewData["Title"] = ViewBag.Screen?.MasterForm?.FormName ?? "Master Detail";
    var screen = ViewBag.Screen as MetaForge.Application.DTOs.MasterDetailScreenDto;
    var formCode = ViewBag.FormCode as string;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.FormPermissionsDto;
    var canSave = perms?.CanCreate == true || perms?.CanEdit == true;
    var moduleName = screen?.MasterForm?.FormName ?? "Record";
    var detailLabel = screen?.DetailForm?.FormName ?? screen?.DetailRelation?.ChildEntity ?? "Line Items";
    var detailColumnLabels = screen?.DetailForm?.Fields?
        .Where(f => f.ControlType != "Hidden")
        .Select(f => f.Label)
        .ToList()
        ?? screen?.DetailGrid?.Columns?.Select(c => c.Label).ToList()
        ?? [];
    var detailColCount = detailColumnLabels.Count;
    var isNew = screen?.MasterData == null;
}

<div class="master-detail-page">
    <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-0">@moduleName Entry</h1>
            <p class="page-subtitle mb-0">Edit header in modal, manage line items below</p>
        </div>
        <div class="d-flex gap-2">
            @if (canSave)
            {
                <button type="button" class="btn btn-primary btn-icon" id="btnSaveAll" title="Save @moduleName" aria-label="Save @moduleName"><i class="fa-solid fa-floppy-disk"></i></button>
            }
            <a class="btn btn-outline-secondary btn-icon" href="/Modules/@formCode" title="Back to List" aria-label="Back to List"><i class="fa-solid fa-arrow-left"></i></a>
        </div>
    </div>

    <div class="card admin-card mb-4 master-summary-card">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <div id="masterSummary" class="flex-grow-1">
                @(isNew ? "No header entered yet." : "Loading header…")
            </div>
            @if (canSave)
            {
                <button type="button" class="btn btn-teal btn-sm btn-icon" id="btnEditMaster" title="@(isNew ? "Enter Header" : "Edit Header")" aria-label="@(isNew ? "Enter Header" : "Edit Header")">
                    <i class="fa-solid fa-pen-to-square"></i>
                </button>
            }
        </div>
    </div>

    <div class="card admin-card master-detail-detail-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@detailLabel</span>
            <div class="d-flex align-items-center gap-2">
                <span class="detail-count-badge"><span id="detailItemCount">0</span> items</span>
                @if (perms?.CanCreate == true)
                {
                    <button type="button" class="btn btn-sm btn-teal btn-icon" id="btnAddDetail" title="Add Item" aria-label="Add Item"><i class="fa-solid fa-plus"></i></button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="detailGrid" class="table table-bordered table-hover master-detail-grid mb-0">
                    <thead>
                        <tr id="detailGridHead">
                            <th style="width:48px">#</th>
                            @foreach (var label in detailColumnLabels)
                            {
                                <th>@label</th>
                            }
                            @if (perms?.CanDelete == true)
                            {
                                <th style="width:72px" class="text-center">Remove</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="detailGridBody"></tbody>
                    <tfoot>
                        <tr id="detailSummaryRow" class="d-none">
                            <td colspan="@(detailColCount + (perms?.CanDelete == true ? 2 : 1))" class="text-end fw-semibold">
                                Line Total: <span id="detailLineTotal">0.00</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade admin-modal" id="masterFormModal" tabindex="-1" aria-labelledby="masterFormModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterFormModalTitle">@moduleName — Header</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="masterForm" data-module="@formCode" data-entity="@screen?.MasterForm?.EntityName"></form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-icon" data-bs-dismiss="modal" title="Cancel" aria-label="Cancel"><i class="fa-solid fa-xmark"></i></button>
                @if (canSave)
                {
                    <button type="button" class="btn btn-teal btn-icon" id="btnApplyMaster" title="Apply Header" aria-label="Apply Header"><i class="fa-solid fa-check"></i></button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const screen = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(screen));
            const permissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(perms));
            MasterDetail.init(screen, '@formCode', permissions, {
                mode: 'split-modal',
                autoOpenMaster: @(isNew ? "true" : "false")
            });
        });
    </script>
}
