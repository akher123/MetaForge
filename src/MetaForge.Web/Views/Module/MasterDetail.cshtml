@{
    ViewData["Title"] = ViewBag.Screen?.MasterForm?.FormName ?? "Master Detail";
    var screen = ViewBag.Screen as MetaForge.Application.DTOs.MasterDetailScreenDto;
    var formCode = ViewBag.FormCode as string;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.FormPermissionsDto;
    var canSave = perms?.CanCreate == true || perms?.CanEdit == true;
    var moduleName = screen?.MasterForm?.FormName ?? "Record";
    var detailLabel = screen?.DetailForm?.FormName ?? screen?.DetailRelation?.ChildEntity ?? "Line Items";
    var detailColumnLabels = screen?.DetailForm?.Fields?
        .Where(f => f.ControlType != "Hidden")
        .Select(f => f.Label)
        .ToList()
        ?? screen?.DetailGrid?.Columns?.Select(c => c.Label).ToList()
        ?? [];
    var detailColCount = detailColumnLabels.Count;
    var isNew = screen?.MasterData == null;
}

<div class="master-detail-page module-page module-page--transaction">
    <div class="page-header module-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <span class="module-page-icon" aria-hidden="true"><i class="fa-solid fa-file-invoice"></i></span>
            <div>
                <h1 class="h3 mb-0">@moduleName Entry</h1>
                @await Component.InvokeAsync("Breadcrumb", new { currentPage = isNew ? "New Entry" : "Edit Entry", requestPath = $"/Modules/{formCode}" })
                <p class="page-subtitle mb-0">Edit the document header and manage line items below</p>
            </div>
        </div>
        @if (canSave)
        {
            <button type="button" class="btn btn-primary" id="btnSaveAll">
                <i class="fa-solid fa-floppy-disk me-1"></i>Save @moduleName
            </button>
        }
    </div>

    <div class="card admin-card mb-4 master-summary-card module-summary-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fa-solid fa-file-lines me-2"></i>Document Header</span>
            @if (canSave)
            {
                <button type="button" class="btn btn-sm btn-teal" id="btnEditMaster">
                    <i class="fa-solid fa-pen-to-square me-1"></i>@(isNew ? "Enter Header" : "Edit Header")
                </button>
            }
        </div>
        <div class="card-body py-3">
            <div id="masterSummary" class="module-summary-content">
                @(isNew ? "No header entered yet." : "Loading header…")
            </div>
        </div>
    </div>

    <div class="card admin-card master-detail-detail-card module-detail-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fa-solid fa-table-list me-2"></i>@detailLabel</span>
            <div class="d-flex align-items-center gap-2">
                <span class="detail-count-badge"><span id="detailItemCount">0</span> items</span>
                @if (perms?.CanCreate == true || perms?.CanEdit == true)
                {
                    <button type="button" class="btn btn-sm btn-teal" id="btnAddDetail">
                        <i class="fa-solid fa-plus me-1"></i>Add Item
                    </button>
                }
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="detailGrid" class="table table-bordered table-hover master-detail-grid mb-0">
                    <thead>
                        <tr id="detailGridHead">
                            <th style="width:48px">#</th>
                            @foreach (var label in detailColumnLabels)
                            {
                                <th>@label</th>
                            }
                            @if (perms?.CanEdit == true || perms?.CanDelete == true)
                            {
                                <th style="width:120px" class="text-center">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="detailGridBody"></tbody>
                    <tfoot>
                        <tr id="detailSummaryRow" class="d-none">
                            <td colspan="@(detailColCount + ((perms?.CanEdit == true || perms?.CanDelete == true) ? 2 : 1))" class="text-end fw-semibold">
                                Line Total: <span id="detailLineTotal">0.00</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade admin-modal module-record-modal" id="masterFormModal" tabindex="-1" aria-labelledby="masterFormModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterFormModalTitle">@moduleName — Header</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="module-form-shell">
                    <form id="masterForm" class="master-detail-form" data-module="@formCode" data-entity="@screen?.MasterForm?.EntityName"></form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel
                </button>
                @if (canSave)
                {
                    <button type="button" class="btn btn-teal" id="btnApplyMaster">
                        <i class="fa-solid fa-check me-1"></i>Apply Header
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const screen = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(screen));
            const permissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(perms));
            MasterDetail.init(screen, '@formCode', permissions, {
                mode: 'split-modal',
                autoOpenMaster: @(isNew ? "true" : "false")
            });
        });
    </script>
}
