@* Tabular master-detail entry modal — master header + multiple detail tabs *@
<div class="modal fade admin-modal module-transaction-modal" id="masterDetailTabularModal" tabindex="-1" aria-labelledby="masterDetailTabularModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterDetailTabularModalTitle">Entry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="modal-section-card module-modal-section">
                    <div class="section-header">
                        <span class="section-icon"><i class="fa-solid fa-file-lines"></i></span>
                        Document Header
                    </div>
                    <div class="section-body">
                        <div class="module-form-shell">
                            <form id="tabularMasterForm" class="master-detail-form" data-module="" data-entity=""></form>
                        </div>
                    </div>
                </div>

                <div class="modal-section-card module-modal-section mb-0">
                    <div class="section-header">
                        <span><span class="section-icon"><i class="fa-solid fa-table-list"></i></span> Detail Sections</span>
                    </div>
                    <div class="section-body p-0">
                        <ul class="nav nav-tabs module-detail-tabs px-3 pt-2" id="detailSectionTabs" role="tablist"></ul>
                        <div class="tab-content module-detail-tab-content p-3" id="detailSectionTabContent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary d-none" id="btnSaveTabularAll">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save Document
                </button>
            </div>
        </div>
    </div>
</div>
