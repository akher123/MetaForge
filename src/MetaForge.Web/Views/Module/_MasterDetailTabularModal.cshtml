@* Tabular master-detail entry modal — master header + multiple detail tabs *@
<div class="modal fade admin-modal" id="masterDetailTabularModal" tabindex="-1" aria-labelledby="masterDetailTabularModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterDetailTabularModalTitle">Entry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="modal-section-card">
                    <div class="section-header">
                        <span class="section-icon"><i class="fa-solid fa-file-lines"></i></span>
                        Document Header
                    </div>
                    <div class="section-body">
                        <form id="tabularMasterForm" data-module="" data-entity=""></form>
                    </div>
                </div>

                <div class="modal-section-card mb-0">
                    <div class="section-header">
                        <span><span class="section-icon"><i class="fa-solid fa-table-list"></i></span> Detail Sections</span>
                    </div>
                    <div class="section-body p-0">
                        <ul class="nav nav-tabs px-3 pt-2" id="detailSectionTabs" role="tablist"></ul>
                        <div class="tab-content p-3" id="detailSectionTabContent"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-icon" data-bs-dismiss="modal" title="Cancel" aria-label="Cancel"><i class="fa-solid fa-xmark"></i></button>
                <button type="button" class="btn btn-primary btn-icon d-none" id="btnSaveTabularAll" title="Save" aria-label="Save"><i class="fa-solid fa-floppy-disk"></i></button>
            </div>
        </div>
    </div>
</div>
