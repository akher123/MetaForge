@{
    ViewData["Title"] = "Form Health Check";
    var report = ViewBag.HealthReport as MetaForge.Application.DTOs.FormHealthReportDto;
    var items = report?.Items?.ToList() ?? new List<MetaForge.Application.DTOs.FormHealthItemDto>();
    var globalIssues = report?.GlobalIssues?.ToList() ?? new List<MetaForge.Application.DTOs.FormHealthGlobalIssueDto>();

    string StatusClass(string status) => status switch
    {
        MetaForge.Application.DTOs.FormHealthStatus.Error => "is-error",
        MetaForge.Application.DTOs.FormHealthStatus.Warning => "is-warning",
        _ => "is-active"
    };

    string StatusLabel(string status) => status switch
    {
        MetaForge.Application.DTOs.FormHealthStatus.Error => "Needs Fix",
        MetaForge.Application.DTOs.FormHealthStatus.Warning => "Review",
        _ => "Healthy"
    };

    string SeverityBadge(string severity) => severity switch
    {
        MetaForge.Application.DTOs.FormHealthSeverity.Error => "text-bg-danger",
        MetaForge.Application.DTOs.FormHealthSeverity.Info => "text-bg-info",
        _ => "text-bg-warning"
    };
}

<div id="formHealthApp" class="app-page-fill admin-hub-page form-builder-page">
    <div class="row g-3 mb-4 form-builder-stat-grid security-stat-grid">
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-primary h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-screens"><i class="fa-solid fa-table-columns"></i></span>
                    <div class="stat-value" id="healthStatTotal">@(report?.TotalForms ?? 0)</div>
                    <div class="stat-label">Total Forms</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-success h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-active"><i class="fa-solid fa-circle-check"></i></span>
                    <div class="stat-value" id="healthStatHealthy">@(report?.HealthyCount ?? 0)</div>
                    <div class="stat-label">Healthy</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-warning h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-transaction"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <div class="stat-value" id="healthStatWarning">@(report?.WarningCount ?? 0)</div>
                    <div class="stat-label">Warnings</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-danger h-100">
                <div class="card-body text-center">
                    <span class="stat-icon"><i class="fa-solid fa-circle-xmark"></i></span>
                    <div class="stat-value" id="healthStatError">@(report?.ErrorCount ?? 0)</div>
                    <div class="stat-label">Errors</div>
                </div>
            </div>
        </div>
    </div>

    @if (globalIssues.Count > 0)
    {
        <div class="card admin-card mb-4">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="fa-solid fa-globe text-info"></i>
                <span class="fw-semibold">Platform Issues</span>
                <span class="badge text-bg-light border">@globalIssues.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var issue in globalIssues)
                    {
                        <div class="list-group-item d-flex flex-wrap align-items-start gap-2">
                            <span class="badge @SeverityBadge(issue.Severity)">@issue.Severity</span>
                            <span class="badge text-bg-light border">@issue.Category</span>
                            <span class="flex-grow-1">@issue.Message</span>
                            @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                            {
                                <a href="@issue.ActionUrl" class="btn btn-sm btn-outline-primary">Action</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="card admin-card admin-grid-card module-grid-card">
        <div class="card-header module-grid-card-header d-flex align-items-center flex-wrap gap-2">
            <div class="module-grid-breadcrumb">
                @await Component.InvokeAsync("Breadcrumb")
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2 module-grid-toolbar ms-auto">
                <span class="fw-semibold"><i class="fa-solid fa-heart-pulse me-2"></i>Form Health</span>
                <span class="text-muted small" id="healthGeneratedAt">
                    @if (report != null)
                    {
                        @:Updated @report.GeneratedAtUtc.ToLocalTime().ToString("g")
                    }
                </span>
                <button type="button" id="btnRefreshHealth" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-rotate me-1"></i>Refresh
                </button>
                <button type="button" id="btnSyncPermissions" class="btn btn-sm btn-outline-primary">
                    <i class="fa-solid fa-shield-halved me-1"></i>Sync Permissions
                </button>
                <a class="btn btn-sm btn-outline-secondary" href="/FormBuilder">
                    <i class="fa-solid fa-arrow-left me-1"></i>Form Builder
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            @if (items.Count == 0)
            {
                <div class="form-builder-empty-state">
                    <div class="form-builder-empty-icon" aria-hidden="true"><i class="fa-solid fa-heart-pulse"></i></div>
                    <h2 class="h6 mb-2">No forms to check</h2>
                    <p class="mb-3">Configure forms in Form Builder to run health checks.</p>
                    <a class="btn btn-primary btn-sm" href="/FormBuilder/Create">
                        <i class="fa-solid fa-plus me-1"></i>Create Form
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive form-builder-screens-table">
                    <table class="table table-sm table-striped table-hover table-bordered w-100 mb-0" id="healthTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:36px"></th>
                                <th>Screen</th>
                                <th>Entity</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Issues</th>
                                <th style="width:140px">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr data-form-id="@item.FormId" class="health-row @(item.IssueCount > 0 ? "health-row-attention" : "")">
                                    <td class="text-center">
                                        @if (item.IssueCount > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0 health-toggle" aria-label="Show issues">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </button>
                                        }
                                    </td>
                                    <td>
                                        <div class="form-builder-screen-cell">
                                            <div>
                                                <span class="form-builder-screen-name">@item.Name</span>
                                                <code class="form-builder-screen-code">@item.Code</code>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="form-builder-entity-text">@item.EntityName</span></td>
                                    <td><span class="form-builder-type-badge">@item.FormType</span></td>
                                    <td><span class="security-status-pill @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td>
                                    <td><span class="menu-order-badge">@item.IssueCount</span></td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a class="btn btn-sm btn-outline-primary btn-icon" href="@item.EditUrl" title="Edit Form"><i class="fa-solid fa-pen-to-square"></i></a>
                                            @if (item.IssueCount > 0)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-warning btn-icon btn-health-sync" data-form-id="@item.FormId" data-form-name="@item.Name" title="Sync from Entity"><i class="fa-solid fa-rotate"></i></button>
                                            }
                                            <a class="btn btn-sm btn-outline-secondary btn-icon" href="@item.ModuleUrl" title="Open Screen"><i class="fa-solid fa-arrow-up-right-from-square"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="healthIssueTemplates" class="d-none" aria-hidden="true">
                    @foreach (var item in items.Where(i => i.IssueCount > 0))
                    {
                        <template id="health-issues-@item.FormId">
                            <div class="health-details-panel">
                                @foreach (var issue in item.Issues)
                                {
                                    <div class="health-issue-item">
                                        <span class="badge @SeverityBadge(issue.Severity)">@issue.Severity</span>
                                        <span class="badge text-bg-light border">@issue.Category</span>
                                        <span>@issue.Message</span>
                                        @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                        {
                                            <a href="@issue.ActionUrl" class="small ms-1">Fix</a>
                                        }
                                    </div>
                                }
                            </div>
                        </template>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/metaforge/entity-schema-sync.js" asp-append-version="true"></script>
    <script src="~/js/metaforge/form-health-check.js" asp-append-version="true"></script>
}
