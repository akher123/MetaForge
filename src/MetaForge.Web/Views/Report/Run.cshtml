@{
    ViewData["Title"] = ViewBag.Definition?.Name ?? "Report";
    var reportCode = ViewBag.ReportCode as string ?? "";
    var definition = ViewBag.Definition as MetaForge.Application.DTOs.ReportDefinitionDto;
    var perms = ViewBag.Permissions as MetaForge.Application.DTOs.ReportPermissionsDto;
    var exportLayout = definition?.ExportLayout;
    var displayTitle = !string.IsNullOrWhiteSpace(exportLayout?.Title) ? exportLayout!.Title : definition?.Name;
    var showTitleUnderline = exportLayout?.ShowTitleUnderline ?? true;
    var showGeneratedTimestamp = exportLayout?.ShowGeneratedTimestamp ?? true;
    var reportType = definition?.ReportType ?? "Tabular";
    var entityName = definition?.EntityName ?? "";
    var filterCount = definition?.Filters?.Count ?? 0;
    var columnCount = definition?.Columns?.Count(c => c.IsVisible) ?? 0;
    var hasHeader = !string.IsNullOrWhiteSpace(exportLayout?.HeaderLeft)
        || !string.IsNullOrWhiteSpace(exportLayout?.HeaderCenter)
        || !string.IsNullOrWhiteSpace(exportLayout?.HeaderRight);
    var hasFooter = !string.IsNullOrWhiteSpace(exportLayout?.FooterLeft)
        || !string.IsNullOrWhiteSpace(exportLayout?.FooterCenter)
        || !string.IsNullOrWhiteSpace(exportLayout?.FooterRight);

    string FormatToken(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        return text
            .Replace("{Title}", displayTitle ?? string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("{Date}", DateTime.Now.ToString("yyyy-MM-dd"), StringComparison.OrdinalIgnoreCase)
            .Replace("{DateTime}", DateTime.Now.ToString("yyyy-MM-dd HH:mm"), StringComparison.OrdinalIgnoreCase);
    }

    var headerLeftText = FormatToken(exportLayout?.HeaderLeft);
    var headerCenterText = FormatToken(exportLayout?.HeaderCenter);
    var headerRightText = FormatToken(exportLayout?.HeaderRight);
    var footerLeftText = FormatToken(exportLayout?.FooterLeft);
    var footerCenterText = FormatToken(exportLayout?.FooterCenter);
    var footerRightText = FormatToken(exportLayout?.FooterRight);

    string BandLayoutClass(string left, string center, string right) =>
        !string.IsNullOrWhiteSpace(center)
        && string.IsNullOrWhiteSpace(left)
        && string.IsNullOrWhiteSpace(right)
            ? " report-preview__band--center-only"
            : string.Empty;

    bool IsNumericColumnFormat(string? displayFormat)
    {
        if (string.IsNullOrWhiteSpace(displayFormat))
            return false;

        var fmt = displayFormat.Trim().ToUpperInvariant();
        return fmt.Length > 0 && "NCPF".Contains(fmt[0]) && (fmt.Length == 1 || char.IsDigit(fmt[1]));
    }

    var reportTypeIcon = reportType switch
    {
        "Grouped" => "fa-layer-group",
        "Summary" => "fa-calculator",
        _ => "fa-table"
    };
}

<div class="report-preview module-page module-page--master app-page-fill">
    <div class="report-preview__sheet">
        @if (hasHeader)
        {
            var headerBandClass = BandLayoutClass(headerLeftText, headerCenterText, headerRightText);
            <div class="report-preview__band report-preview__band--header@headerBandClass" aria-label="Report header">
                @if (headerBandClass.Contains("center-only", StringComparison.Ordinal))
                {
                    <span class="report-preview__band-item report-preview__band-item--center">@headerCenterText</span>
                }
                else
                {
                    <span class="report-preview__band-item report-preview__band-item--left">@headerLeftText</span>
                    <span class="report-preview__band-item report-preview__band-item--center">@headerCenterText</span>
                    <span class="report-preview__band-item report-preview__band-item--right">@headerRightText</span>
                }
            </div>
        }

        <header class="report-preview__masthead">
            <div class="report-preview__masthead-main">
                <div class="report-preview__eyebrow">
                    <span class="report-preview__badge report-preview__badge--type">
                        <i class="fa-solid @reportTypeIcon me-1" aria-hidden="true"></i>@reportType
                    </span>
                    @if (!string.IsNullOrWhiteSpace(entityName))
                    {
                        <span class="report-preview__badge report-preview__badge--entity">@entityName</span>
                    }
                    @if (filterCount > 0)
                    {
                        <span class="report-preview__badge report-preview__badge--muted">@filterCount filter@(filterCount == 1 ? "" : "s")</span>
                    }
                </div>
                <h1 class="report-preview__title@(showTitleUnderline ? " report-preview__title--underlined" : "")">@displayTitle</h1>
                @if (!string.IsNullOrWhiteSpace(definition?.Description))
                {
                    <p class="report-preview__subtitle">@definition.Description</p>
                }
                @if (showGeneratedTimestamp)
                {
                    <p class="report-preview__meta">
                        <i class="fa-regular fa-clock me-1" aria-hidden="true"></i>
                        <span>Generated @DateTime.Now.ToString("MMMM d, yyyy 'at' HH:mm")</span>
                    </p>
                }
            </div>
            <div class="report-preview__toolbar" role="toolbar" aria-label="Report actions">
                @if (perms?.CanExport == true)
                {
                    <div class="btn-group report-preview__export-group" role="group" aria-label="Export">
                        <button type="button" class="btn btn-sm btn-export-pdf" id="btnExportPdf" title="Export PDF">
                            <i class="fa-solid fa-file-pdf me-1"></i>PDF
                        </button>
                        <button type="button" class="btn btn-sm btn-export-excel" id="btnExportExcel" title="Export Excel">
                            <i class="fa-solid fa-file-excel me-1"></i>Excel
                        </button>
                    </div>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnResetFilters" title="Reset filters">
                    <i class="fa-solid fa-rotate-left me-1"></i>Reset
                </button>
                <button type="button" class="btn btn-sm btn-primary report-preview__run-btn" id="btnApplyFilters">
                    <i class="fa-solid fa-play me-1"></i>Run Report
                </button>
            </div>
        </header>

        @if (filterCount > 0)
        {
            <section class="report-preview__filters@(filterCount > 0 ? "" : " d-none")" id="reportFilterSection" aria-labelledby="reportFiltersHeading">
                <div class="report-preview__section-head">
                    <h2 class="report-preview__section-title" id="reportFiltersHeading">
                        <i class="fa-solid fa-sliders me-2" aria-hidden="true"></i>Parameters
                    </h2>
                    <p class="report-preview__section-hint mb-0">Adjust criteria and run the report to refresh results.</p>
                </div>
                <div class="report-preview__filter-grid row g-3" id="reportFilterPanel"></div>
            </section>
        }

        <section class="report-preview__results admin-grid-card admin-grid-card--fill" aria-labelledby="reportResultsHeading">
            <div class="report-preview__results-head">
                <div>
                    <h2 class="report-preview__section-title mb-0" id="reportResultsHeading">
                        <i class="fa-solid fa-table-list me-2" aria-hidden="true"></i>Results
                    </h2>
                    <p class="report-preview__section-hint mb-0">@columnCount visible column@(columnCount == 1 ? "" : "s")</p>
                </div>
                <span class="report-preview__stat" id="reportRecordStat" aria-live="polite">—</span>
            </div>
            <div class="report-preview__grid-wrap">
                <table id="reportGrid"
                       class="table table-sm table-hover w-100 mb-0 report-preview__table"
                       data-report-code="@reportCode"
                       data-entity="@entityName">
                    <thead>
                        <tr>
                            @if (definition?.Columns != null)
                            {
                                @foreach (var col in definition.Columns.Where(c => c.IsVisible))
                                {
                                    var thClass = IsNumericColumnFormat(col.DisplayFormat) ? "text-end" : null;
                                    <th scope="col" class="@thClass" data-property="@col.PropertyName">@col.Label</th>
                                }
                            }
                        </tr>
                    </thead>
                </table>
            </div>
        </section>

        @if (hasFooter)
        {
            var footerBandClass = BandLayoutClass(footerLeftText, footerCenterText, footerRightText);
            <footer class="report-preview__band report-preview__band--footer@footerBandClass" aria-label="Report footer">
                @if (footerBandClass.Contains("center-only", StringComparison.Ordinal))
                {
                    <span class="report-preview__band-item report-preview__band-item--center">@footerCenterText</span>
                }
                else
                {
                    <span class="report-preview__band-item report-preview__band-item--left">@footerLeftText</span>
                    <span class="report-preview__band-item report-preview__band-item--center">@footerCenterText</span>
                    <span class="report-preview__band-item report-preview__band-item--right">@footerRightText</span>
                }
            </footer>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.__reportRuntime = {
            reportCode: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reportCode)),
            definition: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(definition)),
            permissions: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(perms))
        };
    </script>
    <script src="~/js/metaforge/dynamic-report.js" asp-append-version="true"></script>
}
