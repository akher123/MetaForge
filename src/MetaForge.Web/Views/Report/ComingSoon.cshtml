@{
    ViewData["Title"] = ViewBag.ReportName ?? "Report";
    var reportCode = ViewBag.ReportCode as string ?? "";
    var reportType = ViewBag.ReportType as string ?? "";
}

<div class="app-page-fill admin-hub-page">
    <div class="card admin-card">
        <div class="card-body text-center py-5">
            <div class="form-builder-empty-icon mb-3" aria-hidden="true"><i class="fa-solid fa-layer-group"></i></div>
            <h1 class="h5 mb-2">@ViewBag.ReportName</h1>
            <p class="text-muted mb-3">
                <strong>@reportType</strong> report execution is planned for Phase 3.
                Tabular reports are available today.
            </p>
            <a href="/ReportBuilder" class="btn btn-outline-secondary btn-sm me-2">Report Builder</a>
            <a href="/ReportBuilder/Edit" class="btn btn-outline-primary btn-sm d-none">Edit</a>
        </div>
    </div>
</div>
