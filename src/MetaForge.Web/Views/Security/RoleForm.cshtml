@using MetaForge.Domain.Enums
@{
    var isEdit = ViewBag.IsEdit as bool? ?? false;
    ViewData["Title"] = isEdit ? "Edit Role" : "New Role";
    var role = ViewBag.Role as MetaForge.Application.DTOs.RoleDetailDto;
    var selectedIds = role?.PermissionIds?.ToHashSet() ?? new HashSet<int>();
    var groups = role?.PermissionGroups ?? new List<MetaForge.Application.DTOs.PermissionGroupDto>();
    var standardActions = PermissionAction.All.ToList();

    int ActionSortKey(string action)
    {
        var idx = standardActions.IndexOf(action);
        return idx >= 0 ? idx : 100;
    }

    var categories = groups
        .GroupBy(g => g.CategoryName)
        .OrderBy(c => c.Key switch
        {
            "System Administration" => 0,
            "Master Data" => 1,
            "Transaction" => 2,
            _ => 3
        })
        .ThenBy(c => c.Key)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">@(isEdit ? "Edit Role" : "New Role")</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Security">Security</a></li>
                <li class="breadcrumb-item"><a href="/Security/Roles">Roles</a></li>
                <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Create")</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card admin-card shadow-sm mb-4">
    <div class="card-body">
        <form id="roleForm">
            <input type="hidden" id="roleId" value="@(role?.Id ?? 0)" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="roleName">Role Name *</label>
                    <input type="text" id="roleName" class="form-control" value="@role?.Name" required />
                </div>
                <div class="col-md-8">
                    <label class="form-label" for="roleDescription">Description</label>
                    <input type="text" id="roleDescription" class="form-control" value="@role?.Description" />
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card admin-card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold"><i class="fa-solid fa-table-columns me-2"></i>Permission Matrix</span>
        <div class="d-flex gap-1">
            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" id="btnExpandAll" title="Expand All" aria-label="Expand All"><i class="fa-solid fa-angles-down"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" id="btnCollapseAll" title="Collapse All" aria-label="Collapse All"><i class="fa-solid fa-angles-up"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" id="btnSelectAll" title="Select All" aria-label="Select All"><i class="fa-solid fa-check-double"></i></button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" id="btnClearAll" title="Clear All" aria-label="Clear All"><i class="fa-solid fa-eraser"></i></button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="permission-matrix" id="permissionMatrix">
            @foreach (var category in categories)
            {
                var catSlug = category.Key.Replace(" ", "_");
                var catId = $"cat_{catSlug}";
                var catPermCount = category.Sum(g => g.Permissions.Count);
                var catSelected = category.SelectMany(g => g.Permissions).Count(p => selectedIds.Contains(p.Id));
                var categoryActions = category
                    .SelectMany(g => g.Permissions)
                    .Select(p => p.Action)
                    .Distinct()
                    .OrderBy(ActionSortKey)
                    .ThenBy(a => a)
                    .ToList();

                <div class="permission-matrix-section" data-category="@category.Key">
                    <div class="permission-matrix-section-header">
                        <button type="button"
                                class="permission-matrix-toggle"
                                data-bs-toggle="collapse"
                                data-bs-target="#@catId"
                                aria-expanded="true"
                                aria-controls="@catId">
                            <i class="fa-solid fa-chevron-down matrix-chevron" aria-hidden="true"></i>
                        </button>
                        <input type="checkbox"
                               class="form-check-input perm-category-check"
                               id="check_@catId"
                               data-category="@category.Key"
                               aria-label="Select all in @category.Key" />
                        <label class="permission-matrix-section-title" for="check_@catId">
                            @category.Key
                            <span class="permission-matrix-meta">
                                · @category.Count() module(s) ·
                                <span class="perm-count" data-category="@category.Key">@catSelected</span>/@catPermCount
                            </span>
                        </label>
                    </div>
                    <div id="@catId" class="collapse show">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered permission-matrix-table mb-0">
                                <thead>
                                    <tr>
                                        <th class="perm-col-module">Module</th>
                                        @foreach (var action in categoryActions)
                                        {
                                            <th class="perm-col-action text-center">
                                                <div class="perm-col-header">
                                                    <input type="checkbox"
                                                           class="form-check-input perm-col-check"
                                                           id="col_@(catSlug)_@action"
                                                           data-category="@category.Key"
                                                           data-action="@action"
                                                           title="Select all @action in @category.Key"
                                                           aria-label="Select all @action in @category.Key" />
                                                    <label for="col_@(catSlug)_@action">@action</label>
                                                </div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in category.OrderBy(g => g.GroupName))
                                    {
                                        var permByAction = group.Permissions.ToDictionary(p => p.Action, p => p);
                                        var groupSelected = group.Permissions.Count(p => selectedIds.Contains(p.Id));
                                        <tr data-module="@group.FormCode">
                                            <td class="perm-col-module">
                                                <div class="perm-module-cell">
                                                    <input type="checkbox"
                                                           class="form-check-input perm-group-check"
                                                           id="row_@(group.FormCode)"
                                                           data-group="@group.FormCode"
                                                           data-category="@category.Key"
                                                           aria-label="Select all for @group.GroupName" />
                                                    <label for="row_@(group.FormCode)">
                                                        <span class="perm-module-name">@group.GroupName</span>
                                                        <span class="perm-module-code">@group.FormCode</span>
                                                        <span class="perm-module-count">
                                                            (<span class="perm-count" data-group="@group.FormCode">@groupSelected</span>/@group.Permissions.Count)
                                                        </span>
                                                    </label>
                                                </div>
                                            </td>
                                            @foreach (var action in categoryActions)
                                            {
                                                <td class="text-center perm-action-cell">
                                                    @if (permByAction.TryGetValue(action, out var perm))
                                                    {
                                                        <input class="form-check-input perm-check"
                                                               type="checkbox"
                                                               value="@perm.Id"
                                                               id="perm_@perm.Id"
                                                               data-group="@group.FormCode"
                                                               data-category="@category.Key"
                                                               data-action="@action"
                                                               title="@perm.Code"
                                                               aria-label="@group.GroupName @action"
                                                               @(selectedIds.Contains(perm.Id) ? "checked" : null) />
                                                    }
                                                    else
                                                    {
                                                        <span class="perm-na" aria-hidden="true">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="card-footer">
        <button type="button" id="btnSaveRole" class="btn btn-primary btn-icon" title="Save Role" aria-label="Save Role"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="/Security/Roles" class="btn btn-secondary btn-icon" title="Cancel" aria-label="Cancel"><i class="fa-solid fa-xmark"></i></a>
    </div>
</div>

@section Scripts {
    <script src="~/js/metaforge/security-management.js" asp-append-version="true"></script>
    <script>SecurityManagement.initRoleForm();</script>
}
