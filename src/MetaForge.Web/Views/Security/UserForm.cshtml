@{
    var isEdit = ViewBag.IsEdit as bool? ?? false;
    ViewData["Title"] = isEdit ? "Edit User" : "New User";
    ViewBag.SecurityNav = "users";
    ViewBag.BreadcrumbPage = isEdit ? "Edit" : "Create";
    var user = ViewBag.User as MetaForge.Application.DTOs.SaveUserDto;
    var roles = ViewBag.Roles as IReadOnlyList<MetaForge.Application.DTOs.RoleOptionDto>;
    var selectedRoles = user?.RoleIds?.ToHashSet() ?? new HashSet<int>();
}

@await Html.PartialAsync("_SecurityPageHeader")

<div class="card admin-card module-grid-card">
    <div class="card-header module-grid-card-header">
        <span class="fw-semibold"><i class="fa-solid fa-id-card me-2"></i>User Details</span>
    </div>
    <div class="card-body">
        <form id="userForm">
            <input type="hidden" id="userId" value="@(user?.Id ?? 0)" />

            <div class="security-form-section">
                <div class="security-form-section-title">
                    <i class="fa-solid fa-circle-user"></i>Account Information
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="userName">Username *</label>
                        <input type="text" id="userName" class="form-control" value="@user?.UserName" required autocomplete="username" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="email">Email *</label>
                        <input type="email" id="email" class="form-control" value="@user?.Email" required autocomplete="email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="password">Password @(isEdit ? "(leave blank to keep)" : "*")</label>
                        <input type="password" id="password" class="form-control" @(isEdit ? "" : "required") autocomplete="@(isEdit ? "new-password" : "new-password")" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input type="checkbox" id="isActive" class="form-check-input" role="switch" @(user?.IsActive != false ? "checked" : null) />
                            <label class="form-check-label" for="isActive">Active account</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="security-form-section">
                <div class="security-form-section-title">
                    <i class="fa-solid fa-shield-halved"></i>Assigned Roles
                </div>
                <div class="security-role-options" id="roleOptions">
                    @if (roles != null && roles.Count > 0)
                    {
                        @foreach (var r in roles)
                        {
                            var inputId = $"role_{r.Id}";
                            <label class="security-role-option" for="@inputId">
                                <input type="checkbox"
                                       class="form-check-input role-check"
                                       id="@inputId"
                                       value="@r.Id"
                                       @(selectedRoles.Contains(r.Id) ? "checked" : null) />
                                <span class="security-role-option-label">@r.Name</span>
                            </label>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0 small">No roles available. Create a role first.</p>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 pt-1">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>Save User
                </button>
                <a href="/Security/Users" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-xmark me-1"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_SecurityPageFooter")

@section Scripts {
    <script src="~/js/metaforge/security-management.js" asp-append-version="true"></script>
    <script>SecurityManagement.initUserForm();</script>
}
