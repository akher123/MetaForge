@{
    ViewData["ScriptBundles"] = new[] { "DataTables" };
    ViewData["Title"] = "Roles";
    ViewBag.SecurityNav = "roles";
    var roles = ViewBag.Roles as IReadOnlyList<MetaForge.Application.DTOs.RoleManagementDto>;
    var canManageRoles = ViewBag.CanManageRoles == true;
}

@await Html.PartialAsync("_SecurityPageHeader")

<div class="card admin-card admin-grid-card module-grid-card">
    <div class="card-header module-grid-card-header">
        <span class="fw-semibold"><i class="fa-solid fa-shield-halved me-2"></i>Role Directory</span>
        <div class="module-grid-toolbar">
            <span class="text-muted small align-self-center">@(roles?.Count ?? 0) role(s)</span>
            @if (canManageRoles)
            {
                <a href="/Security/Roles/Create" class="btn btn-sm btn-primary" title="New Role" aria-label="New Role">
                    <i class="fa-solid fa-plus me-1"></i>New Role
                </a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm table-striped table-hover table-bordered w-100 mb-0" id="rolesTable">
            <thead class="table-light">
                <tr>
                    <th>Role</th>
                    <th>Users</th>
                    <th>Permissions</th>
                    <th style="width:120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (roles != null)
                {
                    @foreach (var r in roles)
                    {
                        <tr>
                            <td>
                                <div class="security-role-cell">
                                    <span class="security-role-icon" aria-hidden="true"><i class="fa-solid fa-shield-halved"></i></span>
                                    <div>
                                        <span class="security-role-name">@r.Name</span>
                                        <span class="security-role-desc">@(string.IsNullOrWhiteSpace(r.Description) ? "No description" : r.Description)</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="security-metric-badge"><i class="fa-solid fa-users"></i>@r.UserCount</span>
                            </td>
                            <td>
                                <span class="security-metric-badge"><i class="fa-solid fa-key"></i>@r.PermissionCount</span>
                            </td>
                            <td>
                                @if (canManageRoles)
                                {
                                    <div class="d-flex gap-1">
                                        <a class="btn btn-sm btn-outline-primary btn-icon" href="/Security/Roles/Edit/@r.Id" title="Edit" aria-label="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                                        @if (r.Name != "Administrator")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-icon btn-delete-role" data-id="@r.Id" data-name="@r.Name" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash"></i></button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_SecurityPageFooter")

@section Scripts {
    <script>
        $(function () {
            $('#rolesTable').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                processing: false,
                metaforgeProgress: false,
                columnDefs: [{ orderable: false, targets: -1 }]
            });

            $(document).on('click', '.btn-delete-role', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                MetaForgeUi.confirmDelete({
                    title: 'Delete Role',
                    message: 'Delete role "' + name + '"?',
                    detail: 'Users assigned to this role will lose its permissions.'
                }).then(function (confirmed) {
                    if (!confirmed) return;
                    $.ajax({ url: '/api/metaforge/security/roles/' + id, method: 'DELETE' })
                        .done(function () {
                            MetaForgeUi.showAlert('Role deleted successfully.', 'success', 3000);
                            window.setTimeout(function () { location.reload(); }, 800);
                        })
                        .fail(function (xhr) {
                            MetaForgeUi.showAlert(xhr.responseJSON?.error ?? 'Delete failed.', 'danger');
                        });
                });
            });
        });
    </script>
}
