@{
    ViewData["Title"] = "Users";
    ViewBag.SecurityNav = "users";
    var users = ViewBag.Users as IReadOnlyList<MetaForge.Application.DTOs.UserManagementDto>;
    var canManageUsers = ViewBag.CanManageUsers == true;

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
}

@await Html.PartialAsync("_SecurityPageHeader")

<div class="card admin-card admin-grid-card module-grid-card">
    <div class="card-header module-grid-card-header">
        <span class="fw-semibold"><i class="fa-solid fa-users me-2"></i>User Directory</span>
        <div class="module-grid-toolbar">
            <span class="text-muted small align-self-center">@(users?.Count ?? 0) user(s)</span>
            @if (canManageUsers)
            {
                <a href="/Security/Users/Create" class="btn btn-sm btn-primary" title="New User" aria-label="New User">
                    <i class="fa-solid fa-user-plus me-1"></i>New User
                </a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm table-striped table-hover w-100 mb-0" id="usersTable">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th style="width:120px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (users != null)
                {
                    @foreach (var u in users)
                    {
                        <tr>
                            <td>
                                <div class="security-user-cell">
                                    <span class="security-user-avatar" aria-hidden="true">@Initials(u.UserName)</span>
                                    <div>
                                        <span class="security-user-name">@u.UserName</span>
                                        <span class="security-user-email">@u.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (u.Roles.Count == 0)
                                {
                                    <span class="text-muted small">No roles</span>
                                }
                                else
                                {
                                    @foreach (var role in u.Roles)
                                    {
                                        <span class="security-role-pill me-1 mb-1"><i class="fa-solid fa-shield-halved"></i>@role</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="security-status-pill is-active">Active</span>
                                }
                                else
                                {
                                    <span class="security-status-pill is-inactive">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (canManageUsers)
                                {
                                    <div class="d-flex gap-1">
                                        <a class="btn btn-sm btn-outline-primary btn-icon" href="/Security/Users/Edit/@u.Id" title="Edit" aria-label="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                                        @if (u.UserName != "admin")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-icon btn-delete-user" data-id="@u.Id" data-name="@u.UserName" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash"></i></button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_SecurityPageFooter")

@section Scripts {
    <script>
        $(function () {
            $('#usersTable').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                processing: false,
                metaforgeProgress: false,
                columnDefs: [{ orderable: false, targets: -1 }]
            });

            $(document).on('click', '.btn-delete-user', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                MetaForgeUi.confirmDelete({
                    title: 'Delete User',
                    message: 'Delete user "' + name + '"?',
                    detail: 'This user will lose access immediately.'
                }).then(function (confirmed) {
                    if (!confirmed) return;
                    $.ajax({ url: '/api/metaforge/security/users/' + id, method: 'DELETE' })
                        .done(function () {
                            MetaForgeUi.showAlert('User deleted successfully.', 'success', 3000);
                            window.setTimeout(function () { location.reload(); }, 800);
                        })
                        .fail(function (xhr) {
                            MetaForgeUi.showAlert(xhr.responseJSON?.error ?? 'Delete failed.', 'danger');
                        });
                });
            });
        });
    </script>
}
