@{
    ViewData["Title"] = "Security Management";
    ViewBag.SecurityNav = "overview";
    ViewBag.ShowSecuritySyncToolbar = ViewBag.CanSyncPermissions == true;
    var overview = ViewBag.Overview as MetaForge.Application.DTOs.SecurityOverviewDto;
    var canViewUsers = ViewBag.CanViewUsers == true;
    var canManageUsers = ViewBag.CanManageUsers == true;
    var canViewRoles = ViewBag.CanViewRoles == true;
    var canViewPermissions = ViewBag.CanViewPermissions == true;
    var canViewAudit = ViewBag.CanViewAudit == true;
}

@await Html.PartialAsync("_SecurityPageHeader")

@if (canViewUsers)
{
    <div class="row g-3 security-stat-grid">
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-primary h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-users"><i class="fa-solid fa-users"></i></span>
                    <div class="stat-value">@(overview?.UserCount ?? 0)</div>
                    <div class="stat-label">Total Users</div>
                    <small class="stat-meta text-success">@(overview?.ActiveUserCount ?? 0) active</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-info h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-roles"><i class="fa-solid fa-shield-halved"></i></span>
                    <div class="stat-value">@(overview?.RoleCount ?? 0)</div>
                    <div class="stat-label">Roles</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="stat-card stat-warning h-100">
                <div class="card-body text-center">
                    <span class="stat-icon stat-icon-perms"><i class="fa-solid fa-key"></i></span>
                    <div class="stat-value">@(overview?.PermissionCount ?? 0)</div>
                    <div class="stat-label">Permissions</div>
                </div>
            </div>
        </div>
        @if (canManageUsers)
        {
            <div class="col-6 col-xl-3">
                <div class="stat-card stat-accent h-100">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                        <span class="stat-icon stat-icon-quick"><i class="fa-solid fa-bolt"></i></span>
                        <div class="stat-label mb-2">Quick Action</div>
                        <a href="/Security/Users/Create" class="btn btn-light btn-sm">
                            <i class="fa-solid fa-user-plus me-1"></i>New User
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row g-3 security-hub-row">
    @if (canViewUsers)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card admin-card security-hub-card h-100">
                <div class="card-body">
                    <span class="security-hub-icon security-hub-icon-users"><i class="fa-solid fa-users"></i></span>
                    <h2 class="h6 mb-0 fw-bold">Users</h2>
                    <p>Create accounts, assign roles, and manage access for each team member.</p>
                    <a href="/Security/Users" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i>Manage Users
                    </a>
                </div>
            </div>
        </div>
    }
    @if (canViewRoles)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card admin-card security-hub-card h-100">
                <div class="card-body">
                    <span class="security-hub-icon security-hub-icon-roles"><i class="fa-solid fa-shield-halved"></i></span>
                    <h2 class="h6 mb-0 fw-bold">Roles</h2>
                    <p>Group permissions into roles and assign them using the permission matrix.</p>
                    <a href="/Security/Roles" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i>Manage Roles
                    </a>
                </div>
            </div>
        </div>
    }
    @if (canViewPermissions)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card admin-card security-hub-card h-100">
                <div class="card-body">
                    <span class="security-hub-icon security-hub-icon-perms"><i class="fa-solid fa-key"></i></span>
                    <h2 class="h6 mb-0 fw-bold">Permissions</h2>
                    <p>Browse all module permissions and sync new ones when forms are added.</p>
                    <a href="/Security/Permissions" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i>View Permissions
                    </a>
                </div>
            </div>
        </div>
    }
    @if (canViewAudit)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card admin-card security-hub-card h-100">
                <div class="card-body">
                    <span class="security-hub-icon security-hub-icon-perms"><i class="fa-solid fa-clipboard-list"></i></span>
                    <h2 class="h6 mb-0 fw-bold">Audit Log</h2>
                    <p>Review who changed what, when, and inspect before/after values for compliance.</p>
                    <a href="/Security/Audit" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-arrow-right me-1"></i>View Audit Log
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_SecurityPageFooter")

@section Scripts {
    @if (ViewBag.ShowSecuritySyncToolbar == true)
    {
        <script>
            $('#btnSyncPermissions').on('click', function () {
                const $btn = $(this).prop('disabled', true);
                $.post('/api/metaforge/security/permissions/sync')
                    .done(function (r) {
                        MetaForgeUi.showAlert(r.message || 'Permissions synced.', 'success', 3000);
                        window.setTimeout(function () { location.reload(); }, 900);
                    })
                    .fail(function (xhr) {
                        MetaForgeUi.showAlert(xhr.responseJSON?.error ?? 'Sync failed.', 'danger');
                    })
                    .always(function () { $btn.prop('disabled', false); });
            });
        </script>
    }
}
