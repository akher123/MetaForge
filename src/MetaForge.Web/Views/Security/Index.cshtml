@{
    ViewData["Title"] = "Security Management";
    var overview = ViewBag.Overview as MetaForge.Application.DTOs.SecurityOverviewDto;
    var canViewUsers = ViewBag.CanViewUsers == true;
    var canManageUsers = ViewBag.CanManageUsers == true;
    var canViewRoles = ViewBag.CanViewRoles == true;
    var canManageRoles = ViewBag.CanManageRoles == true;
    var canViewPermissions = ViewBag.CanViewPermissions == true;
    var canSyncPermissions = ViewBag.CanSyncPermissions == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Security Management</h1>
        <p class="text-muted mb-0">Manage users, roles, and permissions</p>
    </div>
    @if (canSyncPermissions)
    {
        <button type="button" id="btnSyncPermissions" class="btn btn-outline-primary btn-icon" title="Sync Module Permissions" aria-label="Sync Module Permissions"><i class="fa-solid fa-rotate"></i></button>
    }
</div>

@if (canViewUsers)
{
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="stat-card stat-primary h-100">
                <div class="card-body text-center py-4">
                    <div class="stat-value">@(overview?.UserCount ?? 0)</div>
                    <div class="stat-label">Total Users</div>
                    <small class="stat-meta text-success">@(overview?.ActiveUserCount ?? 0) active</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-info h-100">
                <div class="card-body text-center py-4">
                    <div class="stat-value">@(overview?.RoleCount ?? 0)</div>
                    <div class="stat-label">Roles</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card stat-warning h-100">
                <div class="card-body text-center py-4">
                    <div class="stat-value">@(overview?.PermissionCount ?? 0)</div>
                    <div class="stat-label">Permissions</div>
                </div>
            </div>
        </div>
        @if (canManageUsers)
        {
            <div class="col-md-3">
                <div class="stat-card stat-accent h-100">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center py-4">
                        <div class="fw-semibold mb-2 stat-label">Quick Access</div>
                        <a href="/Security/Users/Create" class="btn btn-light btn-sm btn-icon" title="New User" aria-label="New User"><i class="fa-solid fa-user-plus"></i></a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row g-4">
    @if (canViewUsers)
    {
        <div class="col-md-4">
            <div class="card admin-card h-100">
                <div class="card-header"><i class="fa-solid fa-users me-2"></i>Users</div>
                <div class="card-body">
                    <p>Create and manage application users. Assign roles to control access.</p>
                    <a href="/Security/Users" class="btn btn-primary btn-icon" title="Manage Users" aria-label="Manage Users"><i class="fa-solid fa-users"></i></a>
                </div>
            </div>
        </div>
    }
    @if (canViewRoles)
    {
        <div class="col-md-4">
            <div class="card admin-card h-100">
                <div class="card-header"><i class="fa-solid fa-shield-halved me-2"></i>Roles</div>
                <div class="card-body">
                    <p>Define roles and assign module permissions using a permission matrix.</p>
                    <a href="/Security/Roles" class="btn btn-primary btn-icon" title="Manage Roles" aria-label="Manage Roles"><i class="fa-solid fa-shield-halved"></i></a>
                </div>
            </div>
        </div>
    }
    @if (canViewPermissions)
    {
        <div class="col-md-4">
            <div class="card admin-card h-100">
                <div class="card-header"><i class="fa-solid fa-key me-2"></i>Permissions</div>
                <div class="card-body">
                    <p>View all module permissions. Sync permissions when new modules are added.</p>
                    <a href="/Security/Permissions" class="btn btn-primary btn-icon" title="View Permissions" aria-label="View Permissions"><i class="fa-solid fa-key"></i></a>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @if (canSyncPermissions)
    {
        <script>
            $('#btnSyncPermissions').on('click', function () {
                $.post('/api/metaforge/security/permissions/sync')
                    .done(r => { alert(r.message); location.reload(); })
                    .fail(xhr => alert(xhr.responseJSON?.error ?? 'Sync failed'));
            });
        </script>
    }
}
