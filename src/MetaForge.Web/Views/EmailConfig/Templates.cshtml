@{
    ViewData["Title"] = "Email Templates";
    var templates = ViewBag.Templates as IReadOnlyList<MetaForge.Application.DTOs.EmailTemplateListItemDto> ?? [];
}

<div class="app-page-fill admin-hub-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h4 mb-1">Email Templates</h1>
            <p class="text-muted small mb-0">Design templates with {{Token}} placeholders and bind to features.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/EmailAdmin" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
            <a href="/EmailAdmin/Templates/Create" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1"></i>New Template</a>
        </div>
    </div>

    <div class="card admin-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Channel</th>
                        <th>Bindings</th>
                        <th>Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in templates)
                    {
                        <tr>
                            <td>@t.Code</td>
                            <td>@t.Name</td>
                            <td>@(t.ChannelName ?? "Default")</td>
                            <td>@t.BindingCount</td>
                            <td>@(t.IsActive ? "Yes" : "No")</td>
                            <td class="text-end">
                                <a href="/EmailAdmin/Templates/Edit/@t.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
