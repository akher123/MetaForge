@model MetaForge.Web.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Localizer["Auth_SignInTitle"];
}

<div class="auth-shell">
    <aside class="auth-brand-panel" aria-label="MetaForge platform">
        <div class="auth-brand-bg" aria-hidden="true">
            <div class="auth-brand-orb auth-brand-orb-1"></div>
            <div class="auth-brand-orb auth-brand-orb-2"></div>
            <div class="auth-brand-grid"></div>
        </div>
        <div class="auth-brand-content">
            <a class="auth-brand-logo" asp-controller="Home" asp-action="Landing">
                <span class="auth-brand-mark"><i class="fa-solid fa-bolt"></i></span>
                <span>Meta<span class="auth-brand-accent">Forge</span></span>
            </a>
            <h1 class="auth-brand-headline">@Localizer["Auth_BrandHeadline"]</h1>
            <p class="auth-brand-lead">
                @Localizer["Auth_BrandLead"]
            </p>
            <ul class="auth-brand-highlights">
                <li>
                    <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
                    <span>@Localizer["Auth_RuntimeForms"]</span>
                </li>
                <li>
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    <span>@Localizer["Auth_RoleBasedAccess"]</span>
                </li>
                <li>
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                    <span>@Localizer["Auth_CleanArchitecture"]</span>
                </li>
            </ul>
        </div>
        <p class="auth-brand-footer">&copy; @DateTime.UtcNow.Year MetaForge</p>
    </aside>

    <section class="auth-signin-panel">
        <a asp-controller="Home" asp-action="Landing" class="auth-back-link">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>@Localizer["Auth_BackToHome"]</span>
        </a>

        <div class="auth-form-card">
            <header class="auth-form-header">
                <h2 class="auth-form-title">@Localizer["Auth_SignIn"]</h2>
                <p class="auth-form-subtitle">@Localizer["Auth_SignInSubtitle"]</p>
            </header>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert auth-alert--success" role="status">
                    <i class="fa-solid fa-circle-check auth-alert-icon" aria-hidden="true"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert auth-alert--danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation auth-alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <form asp-action="Login"
                  method="post"
                  class="auth-form"
                  novalidate
                  data-signing-in="@Localizer["Auth_SigningIn"]">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="auth-field">
                    <label asp-for="UserName" class="auth-label">@Localizer["Auth_Username"]</label>
                    <div class="auth-input-wrap">
                        <i class="fa-solid fa-user auth-input-icon" aria-hidden="true"></i>
                        <input asp-for="UserName"
                               class="form-control auth-input"
                               placeholder="@Localizer["Auth_UsernamePlaceholder"]"
                               autofocus
                               autocomplete="username"
                               aria-required="true" />
                    </div>
                    <span asp-validation-for="UserName" class="auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="auth-label">@Localizer["Auth_Password"]</label>
                    <div class="auth-input-wrap">
                        <i class="fa-solid fa-lock auth-input-icon" aria-hidden="true"></i>
                        <input asp-for="Password"
                               type="password"
                               id="passwordInput"
                               class="form-control auth-input auth-input--password"
                               placeholder="@Localizer["Auth_PasswordPlaceholder"]"
                               autocomplete="current-password"
                               aria-required="true" />
                        <button type="button"
                                class="auth-password-toggle"
                                id="passwordToggle"
                                aria-label="@Localizer["Auth_ShowPassword"]"
                                aria-pressed="false"
                                data-label-show="@Localizer["Auth_ShowPassword"]"
                                data-label-hide="@Localizer["Auth_HidePassword"]">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                <div class="auth-form-options">
                    <div class="form-check auth-remember">
                        <input asp-for="RememberMe" class="form-check-input" id="RememberMe" />
                        <label asp-for="RememberMe" class="form-check-label" for="RememberMe">@Localizer["Auth_RememberMe"]</label>
                    </div>
                    <a asp-action="ForgotPassword" class="auth-forgot-link">@Localizer["Auth_ForgotPassword"]</a>
                </div>

                <button type="submit" id="authSubmitBtn" class="btn btn-auth-submit w-100">
                    <span class="auth-submit-label">@Localizer["Auth_SignIn"]</span>
                    <i class="fa-solid fa-arrow-right auth-submit-icon ms-2" aria-hidden="true"></i>
                </button>
            </form>
        </div>

        <p class="auth-panel-footer">
            @Localizer["Auth_SecuredFooter"]
        </p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
