@model MetaForge.Web.Models.PreferencesViewModel
@{
    ViewData["Title"] = Localizer["Prefs_Title"];
}

<div class="page-header page-header--preferences">
    <div class="page-header-main">
        @await Component.InvokeAsync("Breadcrumb", new { currentPage = Localizer["Prefs_Title"].Value })
        <h1 class="page-title">
            <i class="fa-solid fa-sliders page-title-icon" aria-hidden="true"></i>
            @Localizer["Prefs_Title"]
        </h1>
        <p class="page-lead">
            @Localizer["Prefs_Lead"]
        </p>
    </div>
</div>

<div class="preferences-page">
    <div class="preferences-page-primary">
        @await Html.PartialAsync("_CulturePicker", Model.Culture)
    </div>

    <aside class="preferences-page-preview" aria-label="@Localizer["Prefs_LivePreview"]">
        <h2 class="preferences-preview-title">
            <i class="fa-solid fa-eye" aria-hidden="true"></i>
            @Localizer["Prefs_LivePreview"]
        </h2>
        <p class="preferences-preview-hint">
            @Localizer["Prefs_PreviewHint"]
        </p>
        <div class="culture-preview culture-preview--settings">
            <h3 class="culture-preview-title">@Localizer["Culture_FormatPreview"]</h3>
            <dl class="culture-preview-list">
                <div class="culture-preview-item">
                    <dt>@Localizer["Culture_Date"]</dt>
                    <dd id="preferencesPreviewDate">@Model.Culture.Preview.ShortDate</dd>
                </div>
                <div class="culture-preview-item">
                    <dt>@Localizer["Culture_DateTime"]</dt>
                    <dd id="preferencesPreviewDateTime">@Model.Culture.Preview.ShortDateTime</dd>
                </div>
                <div class="culture-preview-item">
                    <dt>@Localizer["Culture_Number"]</dt>
                    <dd id="preferencesPreviewNumber">@Model.Culture.Preview.SampleNumber</dd>
                </div>
            </dl>
        </div>
        <div class="preferences-page-help">
            <h3 class="preferences-page-help-title">@Localizer["Prefs_HowOverridesWork"]</h3>
            <ul class="preferences-page-help-list">
                <li>@Localizer["Prefs_CultureHelp"]</li>
                <li>@Localizer["Prefs_DateFormatHelp"]</li>
                <li>@Localizer["Prefs_SystemDefaultHelp"]</li>
            </ul>
        </div>
    </aside>
</div>
