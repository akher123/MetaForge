@model MetaForge.Web.Models.ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-shell">
    <aside class="auth-brand-panel" aria-label="MetaForge platform">
        <div class="auth-brand-bg" aria-hidden="true">
            <div class="auth-brand-orb auth-brand-orb-1"></div>
            <div class="auth-brand-orb auth-brand-orb-2"></div>
            <div class="auth-brand-grid"></div>
        </div>
        <div class="auth-brand-content">
            <a class="auth-brand-logo" asp-controller="Home" asp-action="Landing">
                <span class="auth-brand-mark"><i class="fa-solid fa-bolt"></i></span>
                <span>Meta<span class="auth-brand-accent">Forge</span></span>
            </a>
            <h1 class="auth-brand-headline">Reset your password</h1>
            <p class="auth-brand-lead">
                Enter your email or username and we will send you a secure link to choose a new password.
            </p>
        </div>
        <p class="auth-brand-footer">&copy; @DateTime.UtcNow.Year MetaForge</p>
    </aside>

    <section class="auth-signin-panel">
        <a asp-action="Login" class="auth-back-link">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to sign in</span>
        </a>

        <div class="auth-form-card">
            <header class="auth-form-header">
                <h2 class="auth-form-title">Forgot password</h2>
                <p class="auth-form-subtitle">We will email you a reset link if the account exists</p>
            </header>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert auth-alert--success" role="status">
                    <i class="fa-solid fa-circle-check auth-alert-icon" aria-hidden="true"></i>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert auth-alert--danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation auth-alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            @if (string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <form asp-action="ForgotPassword" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="auth-field">
                        <label asp-for="EmailOrUserName" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-envelope auth-input-icon" aria-hidden="true"></i>
                            <input asp-for="EmailOrUserName"
                                   class="form-control auth-input"
                                   placeholder="Email or username"
                                   autofocus
                                   autocomplete="username"
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="EmailOrUserName" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="btn btn-auth-submit w-100">
                        Send reset link
                        <i class="fa-solid fa-paper-plane ms-2" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <a asp-action="Login" class="btn btn-auth-submit w-100">
                    Return to sign in
                    <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
                </a>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
