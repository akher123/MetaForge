@model MetaForge.Web.Models.ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
    var canSubmit = string.IsNullOrEmpty(Model.ErrorMessage) && !string.IsNullOrEmpty(Model.Token);
}

<div class="auth-shell">
    <aside class="auth-brand-panel" aria-label="MetaForge platform">
        <div class="auth-brand-bg" aria-hidden="true">
            <div class="auth-brand-orb auth-brand-orb-1"></div>
            <div class="auth-brand-orb auth-brand-orb-2"></div>
            <div class="auth-brand-grid"></div>
        </div>
        <div class="auth-brand-content">
            <a class="auth-brand-logo" asp-controller="Home" asp-action="Landing">
                <span class="auth-brand-mark"><i class="fa-solid fa-bolt"></i></span>
                <span>Meta<span class="auth-brand-accent">Forge</span></span>
            </a>
            <h1 class="auth-brand-headline">Choose a new password</h1>
            <p class="auth-brand-lead">
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <text>Set a secure password for <strong>@Model.UserName</strong>.</text>
                }
                else
                {
                    <text>Use the link from your email to set a new password.</text>
                }
            </p>
        </div>
        <p class="auth-brand-footer">&copy; @DateTime.UtcNow.Year MetaForge</p>
    </aside>

    <section class="auth-signin-panel">
        <a asp-action="Login" class="auth-back-link">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            <span>Back to sign in</span>
        </a>

        <div class="auth-form-card">
            <header class="auth-form-header">
                <h2 class="auth-form-title">Reset password</h2>
                <p class="auth-form-subtitle">Enter and confirm your new password</p>
            </header>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert auth-alert--danger" role="alert">
                    <i class="fa-solid fa-circle-exclamation auth-alert-icon" aria-hidden="true"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            @if (canSubmit)
            {
                <form asp-action="ResetPassword" method="post" class="auth-form" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div class="auth-field">
                        <label asp-for="NewPassword" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-lock auth-input-icon" aria-hidden="true"></i>
                            <input asp-for="NewPassword"
                                   type="password"
                                   id="newPasswordInput"
                                   class="form-control auth-input auth-input--password"
                                   placeholder="At least 8 characters"
                                   autofocus
                                   autocomplete="new-password"
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="NewPassword" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword" class="auth-label"></label>
                        <div class="auth-input-wrap">
                            <i class="fa-solid fa-lock auth-input-icon" aria-hidden="true"></i>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control auth-input auth-input--password"
                                   placeholder="Re-enter your password"
                                   autocomplete="new-password"
                                   aria-required="true" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
                    </div>

                    <button type="submit" class="btn btn-auth-submit w-100">
                        Update password
                        <i class="fa-solid fa-check ms-2" aria-hidden="true"></i>
                    </button>
                </form>
            }
            else
            {
                <a asp-action="ForgotPassword" class="btn btn-auth-submit w-100">
                    Request a new link
                    <i class="fa-solid fa-envelope ms-2" aria-hidden="true"></i>
                </a>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
