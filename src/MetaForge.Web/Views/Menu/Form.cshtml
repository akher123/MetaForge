@{
    ViewData["Title"] = ViewBag.IsEdit == true ? "Edit Menu Item" : "New Menu Item";
    var isEdit = ViewBag.IsEdit as bool? ?? false;
    var entry = ViewBag.Entry as MetaForge.Application.DTOs.MenuEntryDto ?? new MetaForge.Application.DTOs.MenuEntryDto();
    var parentOptions = ViewBag.ParentOptions as IReadOnlyList<MetaForge.Application.DTOs.MenuParentOptionDto>;
    var moduleOptions = ViewBag.FormOptions as IReadOnlyList<MetaForge.Application.DTOs.MenuFormOptionDto>;
    var itemType = string.IsNullOrEmpty(entry.ItemType) ? "Folder" : entry.ItemType;
    if (itemType == "Module") itemType = "Form";
    var menuAction = string.IsNullOrEmpty(entry.Action) ? "Index" : entry.Action;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">@(isEdit ? "Edit Menu Item" : "New Menu Item")</h1>
        <p class="text-muted mb-0">Define folder, module link, or custom URL for sidebar navigation.</p>
    </div>
    <a class="btn btn-outline-secondary btn-icon" href="/Menu" title="Back" aria-label="Back"><i class="fa-solid fa-arrow-left"></i></a>
</div>

<div id="menuFormApp" class="card admin-card" data-is-edit="@isEdit.ToString().ToLower()">
    <div class="card-body">
        <input type="hidden" id="menuId" value="@entry.Id" />

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Parent Folder</label>
                <select id="parentId" class="form-select">
                    <option value="">— Root Level —</option>
                    @if (parentOptions != null)
                    {
                        @foreach (var p in parentOptions)
                        {
                            var prefix = new string('\u2014', p.Depth);
                            if (entry.ParentId == p.Id)
                            {
                                <option value="@p.Id" selected="selected">@prefix @p.Name</option>
                            }
                            else
                            {
                                <option value="@p.Id">@prefix @p.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Name *</label>
                <input type="text" id="menuName" class="form-control" value="@entry.Name" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Item Type *</label>
                <select id="itemType" class="form-select">
                    @if (itemType == "Folder")
                    {
                        <option value="Folder" selected="selected">Folder</option>
                    }
                    else
                    {
                        <option value="Folder">Folder</option>
                    }
                    @if (itemType == "Form")
                    {
                        <option value="Form" selected="selected">Module</option>
                    }
                    else
                    {
                        <option value="Form">Module</option>
                    }
                    @if (itemType == "Url")
                    {
                        <option value="Url" selected="selected">Custom URL</option>
                    }
                    else
                    {
                        <option value="Url">Custom URL</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Icon (Font Awesome class)</label>
                <input type="text" id="menuIcon" class="form-control" value="@entry.Icon" placeholder="fa-database" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Display Order</label>
                <input type="number" id="displayOrder" class="form-control" value="@entry.DisplayOrder" min="0" />
            </div>

            <div class="col-md-6 module-fields">
                <label class="form-label">Module *</label>
                <select id="moduleId" class="form-select">
                    <option value="">— Select Module —</option>
                    @if (moduleOptions != null)
                    {
                        @foreach (var m in moduleOptions)
                        {
                            if (entry.FormId == m.Id)
                            {
                                <option value="@m.Id" selected="selected">@m.Name (@m.Code)</option>
                            }
                            else
                            {
                                <option value="@m.Id">@m.Name (@m.Code)</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 module-fields">
                <label class="form-label">Action *</label>
                <select id="menuAction" class="form-select">
                    <option value="Index" selected="@(menuAction == "Index" || menuAction == "MasterDetail")">List / Grid</option>
                    <option value="Create" selected="@(menuAction == "Create")">Create Form</option>
                </select>
            </div>

            <div class="col-md-12 url-fields">
                <label class="form-label">URL *</label>
                <input type="text" id="menuUrl" class="form-control" value="@entry.Url" placeholder="/Home/Dashboard" />
            </div>

            <div class="col-md-12">
                <div class="form-check">
                    <input type="checkbox" id="isActive" class="form-check-input" checked="@(entry.IsActive || !isEdit)" />
                    <label class="form-check-label" for="isActive">Active</label>
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="button" id="btnSaveMenu" class="btn btn-primary btn-lg btn-icon" title="Save" aria-label="Save"><i class="fa-solid fa-floppy-disk"></i></button>
            <a href="/Menu" class="btn btn-secondary btn-lg btn-icon" title="Cancel" aria-label="Cancel"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/metaforge/menu-management.js" asp-append-version="true"></script>
}
