<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\MetaForge.Web\MetaForge.Web.csproj" />
    <ProjectReference Include="..\..\Platform\MetaForge.Infrastructure\MetaForge.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\MasterData\MasterData.Infrastructure\MasterData.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Sales\Sales.Infrastructure\Sales.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Hr\Hr.Infrastructure\Hr.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Free dev-server ports when a previous run did not shut down cleanly -->
  <Target Name="FreeDevServerPorts" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -Command &quot;$ports=7044,5288; foreach($port in $ports){ Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue } }&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
